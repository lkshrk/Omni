# syntax=docker/dockerfile:1.23

FROM golang:1.26-alpine AS integration-test

# stow  — dotfile symlink manager (needed by integration tests)
# git   — used by dots pull/push/status in integration tests
# bash  — used by release/test wrapper scripts and their regressions
# build-base provides the C toolchain required by `go test -race`.
RUN apk add --no-cache \
        bash \
        build-base \
        git \
        nodejs \
        npm \
        py3-pip \
        python3 \
        stow

# Pre-install a small pip package so pip integration tests have something to query.
# --break-system-packages is required by externally-managed system Python installs.
RUN pip3 install --break-system-packages cowsay==6.1

WORKDIR /app

RUN adduser -D -u 10001 omni && chown omni:omni /app

# Configure git so dots tests that commit don't fail on missing identity.
RUN git config --system user.email "ci@omni" && \
    git config --system user.name "omni-ci"

# Run tests as an unprivileged user. Several filesystem error-path tests rely on
# chmod denying access; root bypasses those permissions and makes the assertions
# meaningless.
USER omni
ENV HOME=/home/omni
ENV GOCACHE=/home/omni/.cache/go-build
ENV GOMODCACHE=/home/omni/.cache/go-mod
ENV TMPDIR=/app/.tmp
ENV GOTMPDIR=/app/.tmp
ENV OMNI_TEST_ISOLATED=1

# Keep module downloads in BuildKit cache instead of baking them into a large
# reusable test image layer.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/home/omni/.cache/go-mod,uid=10001,gid=10001 \
    --mount=type=cache,target=/app/.tmp,uid=10001,gid=10001 \
    go mod download

COPY --chown=omni:omni . .

RUN --mount=type=cache,target=/home/omni/.cache/go-mod,uid=10001,gid=10001 \
    --mount=type=cache,target=/home/omni/.cache/go-build,uid=10001,gid=10001 \
    --mount=type=cache,target=/app/.tmp,uid=10001,gid=10001 \
    go test -count=1 -race -trimpath ./... && \
    go test -count=1 -tags=integration -race -trimpath -v ./integration_tests/... ./internal/provider/...
