# syntax=docker/dockerfile:1.26

FROM golang:1.27-alpine AS integration-test

# Integration tests exercise Bash commands, Git-backed dots, and Stow symlinks.
# build-base provides the C toolchain required by `go test -race`.
RUN apk add --no-cache \
        bash \
        build-base \
        git \
        nodejs \
        npm \
        py3-pip \
        python3 \
        stow

RUN npm install --global \
        @anthropic-ai/claude-code@2.1.214 \
        @openai/codex@0.144.5

ARG TARGETARCH
ARG GROK_VERSION=0.2.103
ARG GROK_SHA256_AMD64=9a597598dd798333f75d2b577960eaa80a479dea6ae891045fe2b03e10b179b2
ARG GROK_SHA256_ARM64=3e5e6f7f90cb8c3f3338bb2abbf638838af0e42620f0f88d3b36a38e09189aba
RUN case "$TARGETARCH" in \
        amd64) grok_arch=x86_64; grok_sha256="$GROK_SHA256_AMD64" ;; \
        arm64) grok_arch=aarch64; grok_sha256="$GROK_SHA256_ARM64" ;; \
        *) echo "unsupported Grok architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    wget -qO /usr/local/bin/grok "https://x.ai/cli/grok-${GROK_VERSION}-linux-${grok_arch}" && \
    echo "${grok_sha256}  /usr/local/bin/grok" | sha256sum -c - && \
    chmod 0755 /usr/local/bin/grok && \
    grok --version

# --break-system-packages is required by externally-managed system Python installs.
RUN pip3 install --break-system-packages cowsay==6.1

WORKDIR /app

RUN adduser -D -u 10001 omni && chown omni:omni /app

RUN git config --system user.email "ci@omni" && \
    git config --system user.name "omni-ci"

# Filesystem error-path tests require an unprivileged user because root bypasses chmod.
USER omni
ENV HOME=/home/omni
ENV GOCACHE=/home/omni/.cache/go-build
ENV GOMODCACHE=/home/omni/.cache/go-mod
ENV TMPDIR=/app/.tmp
ENV GOTMPDIR=/app/.tmp
ENV OMNI_TEST_ISOLATED=1

# modules live in a layer, not a cache mount: cache mounts never reach the CI layer cache
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/app/.tmp,uid=10001,gid=10001 \
    go mod download

COPY --chown=omni:omni . .

ARG TEST_PACKAGES="./integration_tests/... ./internal/provider/..."
RUN --mount=type=cache,target=/home/omni/.cache/go-build,uid=10001,gid=10001 \
    --mount=type=cache,target=/app/.tmp,uid=10001,gid=10001 \
    go test -count=1 -tags=integration -race -trimpath $TEST_PACKAGES
