{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/apm/schemas/import-plan-v1.json",
  "title": "APM native import plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinator", "operation_id", "plan_id", "resolution_id", "scope", "sources", "candidate_set_id", "inventory_fingerprint", "items", "summary", "warnings", "blockers"],
  "properties": {
    "schema_version": {"const": 1},
    "coordinator": {"enum": ["standalone", "omni-v24"]},
    "operation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resolution_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"const": "global"},
    "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_set_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inventory_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "candidate_ids", "kind", "name", "classification", "proposed_action", "current_targets", "proposed_targets", "proposed_destination", "reason_codes", "resolution"],
        "properties": {
          "id": {"type": "string"},
          "candidate_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "kind": {"type": "string"},
          "name": {"type": "string"},
          "classification": {"enum": ["already-managed", "duplicate", "importable", "local-package", "needs-choice", "conflict", "secret-blocked", "unsupported", "excluded"]},
          "proposed_action": {"enum": ["snapshot", "reuse", "retain", "block"]},
          "current_targets": {"type": "array", "items": {"type": "string"}},
          "proposed_targets": {"type": "array", "items": {"type": "string"}},
          "proposed_destination": {"type": "string"},
          "reason_codes": {"type": "array", "items": {"type": "string"}},
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "selected_origin_id", "approved_targets", "env_bindings", "approved_executables"],
            "properties": {
              "decision": {"enum": ["", "import", "reuse", "exclude", "broaden", "select-origin", "map-secret", "retain"]},
              "selected_origin_id": {"type": "string"},
              "approved_targets": {"type": "array", "items": {"type": "string"}},
              "env_bindings": {"type": "object", "additionalProperties": {"type": "string"}},
              "approved_executables": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "warnings": {"type": "array"},
    "blockers": {"type": "array"}
  }
}
