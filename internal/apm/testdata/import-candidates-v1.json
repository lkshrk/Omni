{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/apm/schemas/import-candidates-v1.json",
  "title": "APM native import candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinator", "scope", "sources", "candidate_set_id", "source_preimages", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "coordinator": {"enum": ["standalone", "omni-v24"]},
    "scope": {"const": "global"},
    "sources": {"type": "array", "items": {"enum": ["claude", "codex", "omni-v24"]}, "uniqueItems": true},
    "candidate_set_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_preimages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "absolute_path", "kind", "size", "mode", "content_fingerprint"],
        "properties": {
          "id": {"type": "string"},
          "absolute_path": {"type": "string"},
          "kind": {"enum": ["file", "directory"]},
          "size": {"type": "integer", "minimum": 0},
          "mode": {"type": "integer", "minimum": 0},
          "content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "root_id", "source_handle", "source_target", "provenance", "payload", "content_fingerprint", "source_preimage_ids", "executable_paths"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["instruction", "agent", "command", "skill", "hook", "plugin", "marketplace", "mcp", "package", "unsupported"]},
          "name": {"type": "string", "minLength": 1},
          "root_id": {"type": "string", "minLength": 1},
          "source_handle": {"type": "string", "minLength": 1},
          "source_target": {"type": "array", "items": {"enum": ["claude", "codex"]}, "minItems": 1, "uniqueItems": true},
          "provenance": {"enum": ["remote", "marketplace", "local-git", "local-only", "unknown"]},
          "payload": {},
          "content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_preimage_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "executable_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "secret_blocked": {"type": "boolean"}
        }
      }
    }
  }
}
