# Doctor reports a foreign takeover as drift, and sync leaves the content untouched.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents skills sync
stdout '^1 installed, 0 failed$'
exists $WORK/home/.claude/skills/demo/SKILL.md

rm $WORK/home/.claude/skills/demo
mkdir $WORK/home/.claude/skills/demo
cp foreign/SKILL.md $WORK/home/.claude/skills/demo/SKILL.md

exec omni --config settings.json doctor --format json
stdout 'drifted on claude-code'
stdout 'agents skills import'

exec omni --config settings.json agents skills sync
stdout '^1 installed, 0 failed$'
! stdout 'already exists for target'
stdout '~ drift: \./source: drifted on claude-code \(another tool owns the skill entry; left untouched\)'
exec sh -c 'test ! -L '"$WORK"'/home/.claude/skills/demo && echo left-untouched'
stdout left-untouched
cmp $WORK/home/.claude/skills/demo/SKILL.md foreign/SKILL.md

-- settings.json --
{"version":20,"settings":{"agents_use":["claude-code"]},"agents":{"packages":[{"source":"./source"}]}}

-- source/skills/demo/SKILL.md --
---
name: demo
description: Native drift test skill.
---

demo

-- foreign/SKILL.md --
---
name: demo
description: Another tool's copy of the same skill.
---

foreign demo
