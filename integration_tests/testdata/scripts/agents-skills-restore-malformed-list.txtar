# A successful add is not enough: malformed machine-readable list output makes
# the package unverifiable, so restore demotes it to a per-package failure.
chmod 0755 $WORK/bin/npx
env PATH=$WORK/bin:$PATH
env XDG_STATE_HOME=$WORK/state

! exec omni --config settings.json agents skills restore
stdout '^0 installed, 1 failed$'
stdout '! o/r: skills list verification failed: parsing skills list JSON:'
stderr 'agent operation\(s\) failed'
grep -count=1 'skills add o/r -g -a codex -y' .omni-cache/npx-calls.log
grep -count=1 'skills list -g --json' .omni-cache/npx-calls.log

-- settings.json --
{"version":1,"settings":{"agents_use":["codex"]},"agents":{"skills":[{"name":"x","source":"o/r"}]}}

-- bin/npx --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/npx-calls.log"
if [ "$1" = "skills" ] && [ "$2" = "add" ]; then
  mkdir -p "${XDG_STATE_HOME}/skills"
  printf '{"version":3,"skills":{"x":{"source":"o/r","sourceType":"github","sourceUrl":"https://github.com/o/r","skillFolderHash":"h1","installedAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:00:00Z"}}}\n' > "${XDG_STATE_HOME}/skills/.skill-lock.json"
  exit 0
fi
if [ "$1" = "skills" ] && [ "$2" = "list" ]; then
  printf 'not-json\n'
  exit 0
fi
exit 1
