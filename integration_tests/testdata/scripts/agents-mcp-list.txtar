# Claude reads $HOME/.claude.json directly; fake Codex keeps status independent of the host PATH.
chmod 0755 $WORK/bin/claude
chmod 0755 $WORK/bin/codex
env PATH=$WORK/bin:$PATH
env HOME=$WORK/home
mkdir $WORK/home

exec omni --config settings.json agents mcp list
stdout 'grafana\s+http\s+claude-code\(✓\)\s+codex\(-\)'
stdout '-- unmanaged \(claude-code\) --'
stdout 'hand-added\s+stdio'

-- settings.json --
{"agents":{"mcp_servers":[
  {"name":"grafana","transport":"http","url":"https://mcp.example.com"}
]}}

-- home/.claude.json --
{"mcpServers":{
  "grafana": {"type": "http", "url": "https://mcp.example.com"},
  "hand-added": {"command": "npx", "args": ["hand-tool"]}
}}

-- bin/claude --
#!/bin/sh
exit 1

-- bin/codex --
#!/bin/sh
set -eu
if [ "$1" = "mcp" ] && [ "$2" = "list" ] && [ "$3" = "--json" ]; then
  printf '[]\n'
  exit 0
fi
exit 1
