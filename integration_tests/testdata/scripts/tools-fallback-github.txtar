# tools fallback requires a resolvable GitHub release asset and preserves config on resolver failure
env OMNI_GITHUB_API_BASE=http://127.0.0.1:1
exec omni --config settings.json hosts ensure testhost

exec omni --config settings.json tools set rg --provider apt
stdout 'Set logical tool "rg"'

! exec omni --config settings.json tools fallback rg --from-github BurntSushi/ripgrep
stderr '/repos/BurntSushi/ripgrep/releases/latest'
exec grep '"provider": "apt"' settings.json
stdout '"provider": "apt"'
! exec grep '"fallback"' settings.json

! exec omni --config settings.json tools fallback rg
stderr 'tools fallback requires --from-github owner/repo or a GitHub git URL in tool config'

-- settings.json --
{}
