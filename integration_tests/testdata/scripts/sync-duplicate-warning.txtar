# a tool may belong to multiple reusable groups; sync succeeds.
# (An item may belong to any number of host groups plus any number of reusable groups.)
exec omni --config settings.json hosts ensure testhost
exec omni --config settings.json tools sync --dry-run
stdout 'Dry-run'

-- settings.json --
{"tools":{"ripgrep":{"provider":"system","install_with":"brew"}},"groups":[{"name":"base","tools":["ripgrep"]},{"name":"work","tools":["ripgrep"]}]}
