# duplicate tool group ownership is rejected before sync runs
! exec omni --config settings.json sync --dry-run
stderr 'tool "ripgrep" already belongs to group "work"'

-- settings.json --
{"tools":{"ripgrep":{"provider":"system","install_with":"brew"}},"hosts":{"testhost":["work"]},"groups":[{"name":"testhost","special":"host","tools":["ripgrep"]},{"name":"work","tools":["ripgrep"]}]}
