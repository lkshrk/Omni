# A removed package skill may remain in the upstream lockfile. Restore succeeds
# when at least one current skill is listed for every target agent.
chmod 0755 $WORK/bin/npx
env PATH=$WORK/bin:$PATH
env XDG_STATE_HOME=$WORK/state

exec omni --config settings.json agents skills restore
stdout '^1 installed, 0 failed$'
! stdout 'skills list verification missing'
grep -count=1 'skills add o/r -g -a claude-code -a codex -y' .omni-cache/npx-calls.log
grep -count=1 'skills list -g --json' .omni-cache/npx-calls.log

-- settings.json --
{"version":1,"settings":{"agents_use":["claude-code","codex"]},"agents":{"skills":[{"name":"current","source":"o/r"}]}}

-- bin/npx --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}" "${XDG_STATE_HOME}/skills"
echo "$*" >> "${OMNI_CACHE_DIR}/npx-calls.log"
if [ "$1" = "skills" ] && [ "$2" = "add" ]; then
  printf '{"version":3,"skills":{"current":{"source":"o/r","sourceType":"github","sourceUrl":"https://github.com/o/r","skillFolderHash":"h1","installedAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:00:00Z"},"removed":{"source":"o/r","sourceType":"github","sourceUrl":"https://github.com/o/r","skillFolderHash":"old","installedAt":"2025-01-01T00:00:00Z","updatedAt":"2025-01-01T00:00:00Z"}}}\n' > "${XDG_STATE_HOME}/skills/.skill-lock.json"
  exit 0
fi
if [ "$1" = "skills" ] && [ "$2" = "list" ]; then
  printf '[{"name":"current","path":"%s/.agents/skills/current","scope":"global","agents":["Claude Code","Codex"]}]\n' "$HOME"
  exit 0
fi
exit 1
