# logical tool CLI story: specs, memberships, destructive handling, dry-run
exec omni --config settings.json profile add default base work archive scratch
stdout 'Profile "default" saved'
exec omni --config settings.json profile set-hostname testhost default
stdout 'testhost'

exec omni --config settings.json tools set ripgrep --provider system --package ripgrep --install-with brew
stdout 'Set logical tool "ripgrep"'
exec omni --config settings.json groups add-tool base ripgrep
stdout 'Added "ripgrep" to group "base"'

exec omni --config settings.json add fd --provider system --install-with brew --group work
stdout 'added fd'
exec omni --config settings.json tools set typescript --provider node --package typescript --install-with npm
stdout 'Set logical tool "typescript"'
exec omni --config settings.json groups add-tool work typescript
stdout 'Added "typescript" to group "work"'
exec omni --config settings.json groups remove-tool work typescript
stdout 'Removed "typescript" from group "work"'
exec omni --config settings.json groups add-tool base typescript
stdout 'Added "typescript" to group "base"'

exec omni --config settings.json tools set jq --provider system --install-with brew
stdout 'Set logical tool "jq"'
exec omni --config settings.json groups add-tool archive jq
stdout 'Added "jq" to group "archive"'
exec omni -y --config settings.json groups delete archive --move-to work
stdout 'Deleted group "archive"'

exec omni --config settings.json groups add-tool base fd
stdout 'Added "fd" to group "base"'
exec omni --config settings.json groups remove-tool work fd
stdout 'Removed "fd" from group "work"'

exec omni --config settings.json tools set shellcheck --provider system --install-with brew
stdout 'Set logical tool "shellcheck"'
exec omni --config settings.json groups add-tool scratch shellcheck
stdout 'Added "shellcheck" to group "scratch"'
exec omni -y --config settings.json groups delete scratch --delete-tools
stdout 'Deleted group "scratch"'

exec omni -y --config settings.json tools delete typescript
stdout 'Deleted logical tool "typescript"'

exec omni --config settings.json groups
stdout '.base.'
stdout '2 tool'
stdout 'work'
stdout '1 tool'
! stdout 'archive'
! stdout 'scratch'

exec omni --config settings.json sync --dry-run --group base
stdout 'Dry-run'
exec omni --config settings.json list --format json
stdout '\[\]'

exec grep '"ripgrep"' settings.json
stdout '"ripgrep"'
exec grep '"fd"' settings.json
stdout '"fd"'
exec grep '"jq"' settings.json
stdout '"jq"'
! exec grep '"shellcheck"' settings.json
! exec grep '"typescript"' settings.json

-- settings.json --
{}
