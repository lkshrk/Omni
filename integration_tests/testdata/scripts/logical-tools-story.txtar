# logical tool CLI story: specs, memberships, destructive handling, dry-run
exec chmod 755 bin/brew bin/npm
env PATH=$WORK/bin:$PATH
exec omni --config settings.json hosts ensure testhost
stdout 'Host "testhost" ensured.'

exec omni --config settings.json tools set ripgrep --provider system --package ripgrep --install-with brew
stdout 'Set logical tool "ripgrep"'
exec omni --config settings.json groups move-tool testhost ripgrep
stdout 'Moved "ripgrep" to group "testhost"'

exec omni --config settings.json tools add fd --provider system --install-with brew --group work
stdout 'added fd'
exec omni --config settings.json tools set typescript --provider node --package typescript --install-with npm
stdout 'Set logical tool "typescript"'
exec omni --config settings.json groups move-tool work typescript
stdout 'Moved "typescript" to group "work"'
exec omni --config settings.json groups remove-tool work typescript
stdout 'Removed "typescript" from group "work"'
exec omni --config settings.json groups move-tool testhost typescript
stdout 'Moved "typescript" to group "testhost"'

exec omni --config settings.json tools set jq --provider system --install-with brew
stdout 'Set logical tool "jq"'
exec omni --config settings.json groups move-tool archive jq
stdout 'Moved "jq" to group "archive"'
exec omni -y --config settings.json groups delete archive --move-to work
stdout 'Deleted group "archive"'

exec omni --config settings.json groups move-tool testhost fd
stdout 'Moved "fd" to group "testhost"'

exec omni --config settings.json tools set shellcheck --provider system --install-with brew
stdout 'Set logical tool "shellcheck"'
exec omni --config settings.json groups move-tool scratch shellcheck
stdout 'Moved "shellcheck" to group "scratch"'
exec omni -y --config settings.json groups delete scratch --delete-tools
stdout 'Deleted group "scratch"'

exec omni -y --config settings.json tools delete-spec typescript
stdout 'Deleted logical tool "typescript"'

exec omni --config settings.json groups
stdout 'testhost'
stdout '2 tool'
stdout 'work'
stdout '1 tool'
! stdout 'archive'
! stdout 'scratch'

exec omni --config settings.json tools sync --dry-run --group testhost
stdout 'Dry-run'
exec omni --config settings.json tools list --format json
stdout '\[\]'

exec grep '"ripgrep"' settings.json
stdout '"ripgrep"'
exec grep '"fd"' settings.json
stdout '"fd"'
exec grep '"jq"' settings.json
stdout '"jq"'
! exec grep '"shellcheck"' settings.json
! exec grep '"typescript"' settings.json

-- bin/brew --
#!/bin/sh
case "$1" in
  leaves)
    ;;
  info)
    # Return empty JSON for --json=v2 calls
    echo '{"formulae":[],"casks":[]}'
    ;;
  list)
    if [ "${2:-}" = "--cask" ]; then
      exit 0
    fi
    echo ""
    ;;
  outdated)
    echo '{"formulae":[],"casks":[]}'
    ;;
  *)
    exit 0
    ;;
esac

-- bin/npm --
#!/bin/sh
exit 1

-- settings.json --
{}
