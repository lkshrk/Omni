# agents skills restore --dry-run prints npx skills add line for each manifest entry
exec omni --config settings.json agents skills restore --dry-run
stdout '^npx skills add o/r#main -s x -g -a claude-code -y$'

-- settings.json --
{"version":1,"agents":{"skills":[{"name":"x","source":"o/r","ref":"main","agents":["claude-code"]}]}}
