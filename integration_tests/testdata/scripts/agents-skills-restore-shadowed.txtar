# agents skills restore skips a package whose repo-segment name matches a
# plugin installed on a target agent (user-scope duplicate of a
# plugin-provided skill is harm, not repair). Regression for da04a5f:
# agents_use is deliberately UNSET here, so the shadow check must fall back
# to the detected agents (claude-code is detected via $HOME/.claude + a
# claude binary on PATH) instead of iterating an empty set and shadowing
# nothing. The fake claude reports plugin "useful-skills" installed; the
# manifest package lkshrk/useful-skills must be skipped and npx never run.
chmod 0755 $WORK/bin/npx
chmod 0755 $WORK/bin/claude
env PATH=$WORK/bin:$PATH
env HOME=$WORK/home
env XDG_STATE_HOME=$WORK/state
mkdir $WORK/home/.claude

exec omni --config settings.json agents skills restore
stdout '^0 installed, 0 failed$'
stdout 'skipped \(provided by plugin\): lkshrk/useful-skills'
! exists .omni-cache/npx-calls.log

# The dry-run path applies the same filter: no pending install line, only the
# skipped marker.
exec omni --config settings.json agents skills restore --dry-run
! stdout 'skills add'
stdout 'skipped \(provided by plugin\): lkshrk/useful-skills'

-- settings.json --
{"version":1,"agents":{"skills":[{"name":"useful-skills","source":"lkshrk/useful-skills"}]}}

-- bin/npx --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/npx-calls.log"
exit 0

-- bin/claude --
#!/bin/sh
set -eu
if [ "$1" = "plugins" ] && [ "$2" = "list" ]; then
  printf '{"installed":[{"id":"useful-skills@lkshrk","version":"0.2.0","scope":"user","enabled":true}],"available":[]}\n'
  exit 0
fi
exit 1
