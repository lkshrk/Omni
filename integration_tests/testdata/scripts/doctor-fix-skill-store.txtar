# Doctor repairs only Omni-owned skill-store artifacts and preserves foreign or valid entries.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents skills sync
stdout '^1 installed, 0 failed$'

symlink $WORK/home/.claude/skills/dangling -> $WORK/data/omni/skills/packages/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/skills/gone
symlink $WORK/home/.claude/skills/foreign -> $WORK/elsewhere/foreign
exec omni-corrupt-skill-metadata $WORK/data/omni/skills/packages

exec omni --config settings.json doctor --format json
stdout 'store: 2 leftover artifact\(s\)'
stdout 'store: 1 skill link\(s\) point at a removed package'
stdout 'store: 1 installed package\(s\) no manifest entry references'
stdout 'store: 1 package\(s\) missing local install metadata'

exec omni --config settings.json doctor --fix --dry-run
stdout 'would remove leftover skill store artifact .*/packages/\.install-abc'
stdout 'would remove leftover skill store artifact .*/\.claude/skills/\.demo\.omni-adopt-9'
stdout 'would remove dangling skill link .*/\.claude/skills/dangling'
stdout 'would remove unreferenced skill package .*/packages/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
stdout 'would rebuild local install metadata for \./source'

exists $WORK/data/omni/skills/packages/.install-abc/staged.txt
exists $WORK/home/.claude/skills/.demo.omni-adopt-9/SKILL.md
exists $WORK/data/omni/skills/packages/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/skills/orphan/SKILL.md
exec sh -c 'test -L '"$WORK"'/home/.claude/skills/dangling && echo dangling-kept'
stdout dangling-kept

exec omni --config settings.json doctor --fix
stdout 'removed leftover skill store artifact .*/packages/\.install-abc'
stdout 'removed leftover skill store artifact .*/\.claude/skills/\.demo\.omni-adopt-9'
stdout 'removed dangling skill link .*/\.claude/skills/dangling'
stdout 'removed unreferenced skill package .*/packages/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
stdout 'rebuilt local install metadata for \./source'

! exists $WORK/data/omni/skills/packages/.install-abc
! exists $WORK/home/.claude/skills/.demo.omni-adopt-9
! exists $WORK/data/omni/skills/packages/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
exec sh -c 'test ! -L '"$WORK"'/home/.claude/skills/dangling && echo dangling-removed'
stdout dangling-removed

exists $WORK/home/.claude/skills/demo/SKILL.md
exists $WORK/home/.claude/skills/keepme/SKILL.md
exists $WORK/home/.claude/skills/foreign/SKILL.md
exists $WORK/data/omni/skills/packages/notapackage/keep.txt

exec omni --config settings.json doctor --format json
! stdout 'leftover artifact'
! stdout 'point at a removed package'
! stdout 'no manifest entry references'
! stdout 'missing local install metadata'

-- settings.json --
{"version":20,"settings":{"agents_use":["claude-code"]},"agents":{"packages":[{"source":"./source"}]}}

-- source/skills/demo/SKILL.md --
---
name: demo
description: The installed package doctor must never touch.
---

demo

-- data/omni/skills/packages/.install-abc/staged.txt --
staging tree an interrupted install left behind

-- data/omni/skills/packages/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/skills/orphan/SKILL.md --
---
name: orphan
description: A canonical package no manifest entry references.
---

orphan

-- data/omni/skills/packages/notapackage/keep.txt --
not a package directory: the store leaves it alone

-- home/.claude/skills/.demo.omni-adopt-9/SKILL.md --
---
name: demo
description: Displaced copy an interrupted adopt left behind.
---

demo

-- home/.claude/skills/keepme/SKILL.md --
---
name: keepme
description: An unmanaged skill Omni never installed.
---

keepme

-- elsewhere/foreign/SKILL.md --
---
name: foreign
description: Another tool's skill, linked from the target directory.
---

foreign
