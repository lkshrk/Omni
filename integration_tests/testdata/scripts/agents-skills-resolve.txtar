# --use-managed replaces foreign content; --use-local retains it and narrows the manifest.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents skills sync
stdout '^1 installed, 0 failed$'
exists $WORK/home/.claude/skills/demo/SKILL.md
exists $WORK/home/.codex/skills/demo/SKILL.md

rm $WORK/home/.claude/skills/demo
mkdir $WORK/home/.claude/skills/demo
cp foreign/SKILL.md $WORK/home/.claude/skills/demo/SKILL.md

exec omni --config settings.json doctor --format json
stdout 'drifted on claude-code'
stdout 'agents skills resolve'

exec omni --config settings.json agents skills resolve ./source --use-managed --dry-run
stdout 'would replace .*/\.claude/skills/demo with omni'
exec sh -c 'test ! -L '"$WORK"'/home/.claude/skills/demo && echo untouched'
stdout untouched

exec omni -y --config settings.json agents skills resolve ./source --use-managed
stdout '^replace .*/\.claude/skills/demo with omni'
exec sh -c 'test -L '"$WORK"'/home/.claude/skills/demo && echo relinked'
stdout relinked
cmp $WORK/home/.claude/skills/demo/SKILL.md source/skills/demo/SKILL.md
exec omni --config settings.json agents skills sync
stdout '^1 installed, 0 failed$'

rm $WORK/home/.claude/skills/demo
mkdir $WORK/home/.claude/skills/demo
cp foreign/SKILL.md $WORK/home/.claude/skills/demo/SKILL.md

exec omni --config settings.json agents skills resolve ./source --use-local --agent claude-code
stdout 'stop managing \./source on claude-code'
cmp $WORK/home/.claude/skills/demo/SKILL.md foreign/SKILL.md

exec omni --config settings.json agents skills sync --dry-run
stdout 'install \./source all discovered skills for targets codex'
exec omni --config settings.json doctor --format json
! stdout 'drifted on claude-code'

rm $WORK/home/.codex/skills/demo
mkdir $WORK/home/.codex/skills/demo
cp foreign/SKILL.md $WORK/home/.codex/skills/demo/SKILL.md
! exec omni --config settings.json agents skills resolve ./source --use-local --agent codex
stderr 'agents skills remove'

-- settings.json --
{"version":20,"settings":{"agents_use":["claude-code","codex"]},"agents":{"packages":[{"source":"./source"}]}}

-- source/skills/demo/SKILL.md --
---
name: demo
description: Native drift resolution test skill.
---

demo

-- foreign/SKILL.md --
---
name: demo
description: Another tool's copy of the same skill.
---

foreign demo

-- home/.claude/.keep --
-- home/.codex/.keep --
