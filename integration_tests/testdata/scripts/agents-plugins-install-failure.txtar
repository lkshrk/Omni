# agents plugins add: fake claude CLI exits 0 on install but prints the
# "Failed to install" marker, matching the real claude CLI's quirky contract.
# omni's adapter turns that into a Go error collected per-agent via
# agentErrsFailure, which now makes the top-level omni command itself fail
# (exit 1, "error: N agent operation(s) failed" on stderr) even though the
# fake claude CLI itself exited 0. The per-agent "  ! agent/name: ..." detail
# line is still printed to stdout before the command returns the error.
chmod 0755 $WORK/bin/claude
env PATH=$WORK/bin:$PATH

exec omni --config settings.json agents plugins marketplace add lkshrk --source lkshrk/marketplace --agents claude-code
stdout 'added lkshrk'

! exec omni --config settings.json agents plugins add --name caveman --marketplace lkshrk --agents claude-code
stdout 'added caveman'
stdout 'claude-code/caveman.*Failed to install'
stderr 'agent operation\(s\) failed'

-- settings.json --
{}

-- bin/claude --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/claude-calls.log"
if [ "$1" = "plugins" ] && [ "$2" = "marketplace" ] && [ "$3" = "list" ] && [ "$4" = "--json" ]; then
  printf '[]\n'
  exit 0
fi
if [ "$1" = "plugins" ] && [ "$2" = "marketplace" ] && [ "$3" = "add" ]; then
  exit 0
fi
if [ "$1" = "plugins" ] && [ "$2" = "install" ]; then
  echo '✘ Failed to install plugin "caveman@lkshrk": plugin not found'
  exit 0
fi
exit 1
