# script provider: install via custom shell command, idempotency via check probe
exec chmod 755 bin/brew
env PATH=$WORK/bin:$PATH

exec omni --config settings.json hosts ensure testhost

# First sync: check fails (marker absent) → install runs → marker created.
exec omni --config settings.json tools sync
stdout 'done: mytool \(script\)'
exec test -f installed-marker

# Second sync: check passes (marker present) → already installed, install NOT re-run.
exec omni --config settings.json tools sync
stdout 'already installed: mytool \(script\)'
! stdout 'done: mytool \(script\)'

-- bin/brew --
#!/bin/sh
if [ "${1:-}" = "tap" ]; then
  exit 0
fi
exit 1

-- settings.json --
{
  "settings": {
    "disabled_providers": ["brew", "node", "python"]
  },
  "tools": {
    "mytool": {
      "provider": "script",
      "options": {
        "install": "touch installed-marker",
        "check": "test -f installed-marker"
      }
    }
  },
  "hosts": { "testhost": [] },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["mytool"] }
  ]
}
