# omni bootstrap persists detected package managers, creates the host, and can skip dots.
#
# Detection priority: bun > pnpm > npm (node), uv > pip3 > pip (python).
# This fixture provides only pnpm/npm/pip3 fakes so the expected detection
# result is pnpm + pip3. A fully controlled PATH (no host dirs) prevents
# real bun/uv from leaking in.
#
# $WORK/bin holds the fake scripts; the testscript binary dir is extracted
# from the first component of the original $PATH so the omni command remains
# available.
exec chmod 755 bin/pnpm bin/npm bin/pip3 bin/apt bin/apk bin/dnf bin/pacman bin/zypper bin/brew bin/pip bin/extract-testscript-bin
exec bin/extract-testscript-bin
env PATH=$WORK/bin:$PATH

stdin init-input

exec omni --config settings.json bootstrap --no-import
stdout 'Detected providers:'
stdout 'node.manager   = pnpm'
stdout 'python.manager = pip3'
stdout 'Created host "testhost"'
stdout 'Skipping dots setup'
exec grep '"pnpm"' settings.json
stdout '"pnpm"'
# pip3 normalizes to the canonical concrete provider "pip" in provider_priority.
exec grep '"pip"' settings.json
stdout '"pip"'
exec grep '"testhost"' settings.json
stdout '"testhost"'

-- init-input --
n
n


-- bin/extract-testscript-bin --
#!/bin/sh
# Copy the testscript omni binary into $WORK/bin so it survives the PATH reset.
# The testscript binary dir is the first PATH component (set by testscript.Run).
tsbin="${PATH%%:*}"
for f in "$tsbin"/*; do
  [ -x "$f" ] && cp "$f" "$WORK/bin/" 2>/dev/null
done

-- bin/pnpm --
#!/bin/sh
case "${1:-}" in
  --version)
    echo "9.0.0"
    ;;
  *)
    exit 1
    ;;
esac

-- bin/npm --
#!/bin/sh
case "${1:-}" in
  --version)
    echo "10.0.0"
    ;;
  *)
    exit 1
    ;;
esac

-- bin/pip3 --
#!/bin/sh
case "${1:-}" in
  --version)
    echo "pip 24.0"
    ;;
  *)
    exit 1
    ;;
esac

-- bin/apt --
#!/bin/sh
exit 1

-- bin/apk --
#!/bin/sh
exit 1

-- bin/dnf --
#!/bin/sh
exit 1

-- bin/pacman --
#!/bin/sh
exit 1

-- bin/zypper --
#!/bin/sh
exit 1

-- bin/brew --
#!/bin/sh
exit 1

-- bin/pip --
#!/bin/sh
exit 1
