# Scenario 1: group-gated restore
# glob/al is ungrouped → restores everywhere
# work/only is in group "work" → restores on testhost (work is active)
# home/only is in group "home" → skipped on testhost (home is not active)
exec omni --config settings.json agents skills sync --dry-run
stdout 'install glob/al all discovered skills for targets codex'
stdout 'install work/only all discovered skills for targets codex'
! stdout 'home/only'

# Scenario 2: legacy agents.skills migrates to packages (ungrouped → restores everywhere)
# Two skills share the same source "o/r"; migration dedupes by source → one package.
# The dry-run must emit one native action for o/r with both selectors.
exec omni --config legacy.json agents skills sync --dry-run
stdout '^install o/r at ref main skills a,b for targets codex$'

-- legacy.json --
{
  "version": 1,
  "settings": {"agents_use": ["codex"]},
  "agents": {
    "skills": [
      {"name": "a", "source": "o/r", "ref": "main"},
      {"name": "b", "source": "o/r"}
    ]
  }
}

-- settings.json --
{
  "version": 1,
  "settings": {"agents_use": ["codex"]},
  "hosts": {"testhost": ["work"]},
  "groups": [
    {"name": "testhost", "special": "host"},
    {"name": "work",  "skills": ["work/only"]},
    {"name": "home",  "skills": ["home/only"]}
  ],
  "agents": {
    "packages": [
      {"source": "glob/al"},
      {"source": "work/only"},
      {"source": "home/only"}
    ]
  }
}
