# Claude MCP import reads $HOME/.claude.json and refuses resolved headers so values the user never typed cannot reach settings.json.
chmod 0755 $WORK/bin/claude
env PATH=$WORK/bin:$PATH
env HOME=$WORK/home

exec omni --config settings.json agents mcp import
stdout -count=1 '-- unmanaged \(claude-code\) --'
stdout 'extra'
stdout 'literal'

! exec omni --config settings.json agents mcp import literal
stderr 'mcp server "literal" sets header\(s\) X-Import to a resolved value'
! stderr 'literal-value'
! exec grep 'literal-value' settings.json

exec omni --config settings.json agents mcp import extra
stdout 'imported extra'
exec grep '"X-Env": "\${IMPORTED_TOKEN}"' settings.json

exec omni --config settings.json agents mcp import
! stdout 'extra'

# Explicit `agents mcp add` accepts the same literal because the user supplied it.
exec omni --config settings.json agents mcp add --name typed --transport http --url https://mcp.example.com --header 'X-Import: literal-value'
stdout 'added typed'
exec grep '"X-Import": "literal-value"' settings.json

! exec omni --config settings.json agents mcp import ghost
stderr 'mcp server "ghost" is not unmanaged in any agent CLI'

-- settings.json --
{}

-- home/.claude.json --
{"mcpServers":{"extra":{"type":"http","url":"https://mcp.example.com","headers":{"X-Env":"${IMPORTED_TOKEN}"}},"literal":{"type":"http","url":"https://mcp.example.com","headers":{"X-Import":"literal-value"}}}}

-- bin/claude --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/claude-calls.log"
if [ "$1" = "mcp" ] && [ "$2" = "add" ]; then
  echo "added $5"
  exit 0
fi
exit 1
