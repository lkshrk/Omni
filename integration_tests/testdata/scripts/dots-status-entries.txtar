# omni dots status with one entry shows the entry in table and git status
env HOME=$WORK
exec git init dotfiles
exec git -C dotfiles config user.email t@t.com
exec git -C dotfiles config user.name T
exec git -C dotfiles commit --allow-empty -m init
exec omni --config settings.json dots status
stdout 'NAME'
stdout 'nvim'
stdout 'working tree clean'

exec omni --config settings.json dots status nvim --format json
stdout '"name":"nvim"'
stdout '"git_status":""'

-- settings.json --
{"settings":{"dots_repo":"~/dotfiles"},"groups":[{"dots":[{"name":"nvim","path":"~/.config/nvim"}]}]}
