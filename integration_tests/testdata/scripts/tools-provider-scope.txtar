# tools set covers global defaults and host-scoped provider overrides
exec omni --config settings.json hosts ensure testhost

exec omni --config settings.json tools set ripgrep --provider brew --global
stdout 'Set logical tool "ripgrep"'
exec grep '"provider": "brew"' settings.json
stdout '"provider": "brew"'

exec omni --config settings.json tools set ripgrep --provider apt --host
stdout 'Set host override for logical tool "ripgrep"'
exec grep '"testhost"' settings.json
stdout '"testhost"'
exec grep '"provider": "apt"' settings.json
stdout '"provider": "apt"'

! exec omni --config settings.json tools set ripgrep --provider brew --host --global
stderr 'use either --host or --global'

-- settings.json --
{}
