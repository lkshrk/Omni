# agents skills restore with a runner that exits 0 but did not actually
# install: the upstream skills CLI can exit 0 on a failed install (same
# quirky contract as `claude plugin`), so omni verifies the EFFECT — a
# successful `skills add` writes the package's entries to the global
# lockfile, and their absence after a zero exit is treated as a failed
# install (verifySkillInstalled, internal/app/agents_skills.go). The fake
# runner's failure text is deliberately marker-FREE (no "Failed to"/"✘") so
# the skillsCLIFailure marker check that runs first stays quiet and this
# fixture keeps the no-lockfile-entries path exercised;
# the marker path is covered by agents-skills-exit0-stale-lock.txtar. The
# detected failure is reported per-package and, via agentErrsFailure, makes
# the top-level omni command fail (exit 1) even though the runner exited 0.
chmod 0755 $WORK/bin/npx
env PATH=$WORK/bin:$PATH
env XDG_STATE_HOME=$WORK/state

! exec omni --config settings.json agents skills restore
stdout '^0 installed, 1 failed$'
stdout '! o/r: skills add o/r exited 0 but wrote no lockfile entries; treating as failed install'
stderr 'agent operation\(s\) failed'
grep -count=1 'skills add o/r -g -y' .omni-cache/npx-calls.log

-- settings.json --
{"version":1,"agents":{"skills":[{"name":"x","source":"o/r"}]}}

-- bin/npx --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/npx-calls.log"
if [ "$1" = "skills" ] && [ "$2" = "add" ]; then
  printf 'installation of skill o/r did not complete\n'
  exit 0
fi
exit 1
