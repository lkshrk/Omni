# `agents sync` runs every feature's restore in one pass, and stays
# converge-only: an unmanaged lockfile package is never claimed into the
# manifest the way `tools sync --all` claims it.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents sync --dry-run
stdout 'skills: install \./source-one'
! stdout 'skills import:'
! exists $WORK/home/.codex/skills/one/SKILL.md

exec omni --config settings.json agents sync
stdout '^skills: 1 installed, 0 failed$'
exists $WORK/home/.codex/skills/one/SKILL.md

# the unmanaged lockfile package stays unmanaged: no claim, no adoption
! exec grep 'owner/stray-skills' settings.json
exists $WORK/home/.agents/skills/stray/SKILL.md

-- settings.json --
{"version":20,"settings":{"agents_use":["codex"]},"agents":{"packages":[{"source":"./source-one"}]}}

-- home/.agents/.skill-lock.json --
{"version":3,"skills":{"stray":{"source":"owner/stray-skills"}}}

-- home/.agents/skills/stray/SKILL.md --
---
name: stray
description: Installed by another CLI, never claimed by restore.
---

stray

-- source-one/skills/one/SKILL.md --
---
name: one
description: First native test skill.
---

one
