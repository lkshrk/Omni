# omni sync --all claims discovered tools and installs missing configured tools
exec chmod 755 bin/brew bin/apt bin/apk bin/dnf bin/pacman bin/zypper bin/pip bin/pip3
env PATH=$WORK/bin:$PATH

exec omni --yes --config settings.json sync --all
stdout 'claiming fzf'
stdout 'done: fd \(system\)'
stdout 'Sync all complete .* 1 installed, 1 added to config'
exec test -f .omni-cache/fake-brew/fd
exec grep '"fzf"' settings.json
stdout '"fzf"'
exec omni --config settings.json list --state unclaimed --format json
stdout '^\[\]$'

-- bin/brew --
#!/bin/sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
  info)
    if [ "${2:-}" = "--json=v2" ] && [ "${3:-}" = "--installed" ]; then
      printf '{"formulae":[{"name":"fzf","full_name":"fzf","desc":"fuzzy finder","installed":[{"version":"0.61.1","installed_on_request":true}]}],"casks":[]}\n'
      exit 0
    fi
    printf '{"formulae":[],"casks":[]}\n'
    ;;
  list)
    shift
    if [ "${1:-}" = "--versions" ]; then
      shift
      if [ "${1:-}" = "--cask" ]; then
        shift
      fi
      pkg="${1:-}"
      case "$pkg" in
        fzf)
          echo "fzf 0.61.1"
          exit 0
          ;;
        fd)
          if [ -f "$state/fd" ]; then
            echo "fd 10.2.0"
            exit 0
          fi
          ;;
      esac
    fi
    exit 1
    ;;
  install)
    : > "$state/$2"
    ;;
esac

-- bin/apt --
#!/bin/sh
exit 1

-- bin/apk --
#!/bin/sh
exit 1

-- bin/dnf --
#!/bin/sh
exit 1

-- bin/pacman --
#!/bin/sh
exit 1

-- bin/zypper --
#!/bin/sh
exit 1

-- bin/pip --
#!/bin/sh
exit 1

-- bin/pip3 --
#!/bin/sh
exit 1

-- settings.json --
{
  "settings": {
    "disabled_providers": ["node", "python"]
  },
  "hosts": { "testhost": [] },
  "tools": {
    "fd": { "provider": "system", "install_with": "brew" }
  },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["fd"] }
  ]
}
