# omni dots status with no entries shows the repo state without an empty table
env HOME=$WORK
exec omni --config settings.json dots status
! stdout 'NAME'
stdout 'working tree clean'

-- settings.json --
{"host_settings":{"testhost":{"dots_repo":"~/dotfiles"}},"hosts":{"testhost":[]},"groups":[{"name":"testhost","special":"host"}]}

-- dotfiles/dotfiles/.keep --
