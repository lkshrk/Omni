# agents skills update (real, non-dry-run): runs the skills CLI via the fake
# npx runner with the lockfile skill names belonging to manifest packages,
# and prints the runner's stdout verbatim.
chmod 0755 $WORK/bin/npx
env PATH=$WORK/bin:$PATH
env XDG_STATE_HOME=$WORK/state

exec omni --config settings.json agents skills update
stdout 'updated 2 skills'
grep -count=1 'skills update -g -y frontend-design tdd' .omni-cache/npx-calls.log

# A runner failure propagates as a non-zero omni exit with its stderr.
env OMNI_FAKE_NPX_FAIL=1
! exec omni --config settings.json agents skills update
stderr 'skills update: .*registry unreachable'

# exit-0-with-marker: the runner exits 0 but prints a skillsCLIFailure
# marker ("✘"); the guard turns the lying zero exit into an error.
env OMNI_FAKE_NPX_FAIL=
env OMNI_FAKE_NPX_MARKER=1
! exec omni --config settings.json agents skills update
stderr 'skills update exited 0 but reported failure: ✘ could not update skills'

-- settings.json --
{"version":1,"agents":{"skills":[{"name":"frontend-design","source":"vercel-labs/agent-skills"},{"name":"tdd","source":"o/r"}]}}

-- state/skills/.skill-lock.json --
{"version":3,"skills":{"frontend-design":{"source":"vercel-labs/agent-skills","sourceType":"github","sourceUrl":"https://github.com/vercel-labs/agent-skills","ref":"main","skillFolderHash":"abc","installedAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:00:00Z"},"tdd":{"source":"o/r","sourceType":"github","sourceUrl":"https://github.com/o/r","ref":"main","skillFolderHash":"def","installedAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:00:00Z"}}}

-- bin/npx --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/npx-calls.log"
if [ "${OMNI_FAKE_NPX_FAIL:-}" = "1" ]; then
  printf 'error: registry unreachable\n' >&2
  exit 1
fi
if [ "${OMNI_FAKE_NPX_MARKER:-}" = "1" ]; then
  printf '✘ could not update skills\n'
  exit 0
fi
if [ "$1" = "skills" ] && [ "$2" = "update" ]; then
  printf 'updated 2 skills\n'
  exit 0
fi
exit 1
