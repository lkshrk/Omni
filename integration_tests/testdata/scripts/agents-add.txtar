# agents add validates source and respects the agents_disabled gate.
#
# The success path (runner invocation) is not exercised here because there is
# no fake npx/bunx binary registered in the test harness. These two error
# paths fire before the runner is ever called and together cover:
#   1. source normalisation rejects malformed input
#   2. requireAgentsEnabled rejects when agents_disabled=true for this host

# 1. invalid source — normalizeSkillSource returns an error
! exec omni --config settings.json agents add 'not-a-valid-source'
stderr 'cannot parse skill source'

# 2. agents disabled gate fires before the runner is called
! exec omni --config disabled.json agents add owner/repo
stderr 'agent skills are disabled'

-- settings.json --
{}

-- disabled.json --
{"host_settings":{"testhost":{"agents_disabled":true}}}
