# tools sync uses fallback as last resort when configured native provider is unavailable.
# apt-get is stubbed to fail its --version probe so apt reads as unavailable on any
# host (CI images lack apt-get; dev boxes have it) — making the fallback path deterministic.
exec chmod 755 bin/brew bin/apt-get
env PATH=$WORK/bin:$PATH

exec omni --config settings.json hosts ensure testhost

exec omni --config settings.json tools sync
stdout 'installed: rg \(apt\)'
exec test -f .omni-cache/fallback/rg
exec grep '"status": "verified"' settings.json
stdout '"status": "verified"'

# A second sync should verify the fallback-owned binary and skip reinstall.
exec omni --config settings.json tools sync
stdout 'already installed: rg \(apt\)'
exec test -f .omni-cache/fallback/rg

-- bin/brew --
#!/bin/sh
if [ "${1:-}" = "tap" ]; then
  exit 0
fi
exit 1

-- bin/apt-get --
#!/bin/sh
# Fail the availability probe so apt is treated as unavailable on every host.
exit 1

-- settings.json --
{
  "version": 7,
  "settings": {
    "disabled_providers": ["brew", "npm", "pip"]
  },
  "tools": {
    "rg": {
      "providers": [{ "provider": "apt" }],
      "fallback": {
        "source": {
          "type": "github",
          "owner": "BurntSushi",
          "repo": "ripgrep",
          "url": "https://github.com/BurntSushi/ripgrep"
        },
        "status": "unverified",
        "binary": "rg",
        "commands": {
          "install": "mkdir -p .omni-cache/fallback && touch .omni-cache/fallback/rg",
          "check": "test -f .omni-cache/fallback/rg",
          "uninstall": "rm -f .omni-cache/fallback/rg"
        }
      }
    }
  },
  "hosts": { "testhost": [] },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["rg"] }
  ]
}
