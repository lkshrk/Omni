# omni reconcile --yes cleans audited dotfile ignore patterns.
exec chmod 755 bin/brew
env PATH=$WORK/bin:$PATH

exec omni --yes --config settings.json reconcile --skip-privileged
stdout 'syncing tools'
stdout 'upgrading tools'
stdout 'fixed dotfile ignore patterns: myapp'
stdout 'Reconcile complete .* 0 installed, 0 added to config, 0 upgraded'

exec grep '"!/settings.json"' settings.json
! exec grep '"!/skills/"' settings.json
! exec grep '"skills"' settings.json
! exec grep '"!/hooks/"' settings.json
! exec grep '"hooks"' settings.json

-- bin/brew --
#!/bin/sh
if [ "${1:-}" = "tap" ]; then
  exit 0
fi
exit 1

-- settings.json --
{
  "settings": {
    "disabled_providers": ["system", "brew", "node", "python"]
  },
  "hosts": { "testhost": [] },
  "groups": [
    {
      "name": "testhost",
      "special": "host",
      "dots": [
        {
          "name": "myapp",
          "path": "~/.myapp",
          "ignore": ["*", "!/settings.json", "!/skills/", "skills", "!/hooks/", "hooks"]
        }
      ]
    }
  ]
}
