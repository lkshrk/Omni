# Native update reacquires configured sources and atomically replaces shared
# content while preserving target links.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents skills sync
stdout '^1 installed, 0 failed$'
grep 'version one' $WORK/home/.codex/skills/demo/SKILL.md

cp updated-SKILL.md source/skills/demo/SKILL.md
exec omni --config settings.json agents skills upgrade
stdout '^updated \./source \(outdated: source content changed\)$'
grep 'version two' $WORK/home/.codex/skills/demo/SKILL.md

# A second update finds nothing new and says so instead of implying a change.
exec omni --config settings.json agents skills upgrade
stdout '^updated \./source \(forced: already up to date\)$'

# --check probes the source without refreshing anything.
exec omni --config settings.json agents skills upgrade --check
stdout '^up to date \./source$'
cp updated-again-SKILL.md source/skills/demo/SKILL.md
exec omni --config settings.json agents skills upgrade --check
stdout '^outdated \./source'
grep 'version two' $WORK/home/.codex/skills/demo/SKILL.md

-- settings.json --
{"version":20,"settings":{"agents_use":["codex"]},"agents":{"packages":[{"source":"./source"}]}}

-- source/skills/demo/SKILL.md --
---
name: demo
description: Native update test.
---

version one

-- updated-SKILL.md --
---
name: demo
description: Native update test.
---

version two

-- updated-again-SKILL.md --
---
name: demo
description: Native update test.
---

version three
