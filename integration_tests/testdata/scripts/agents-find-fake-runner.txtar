# agents find: exercises the full find pipeline with a fake npx binary.
# Covers: ANSI-colored output stripped and parsed, nomatch query returns empty.
chmod 0755 $WORK/bin/npx
env PATH=$WORK/bin:$PATH

# ANSI-colored result lines get stripped; both entries appear in output
exec omni --config settings.json agents find something
stdout 'owner/repo  \(skill-name\)  12\.3K installs'
stdout 'other-owner/other-repo  \(other-skill\)  456 installs'

# nomatch query yields no output and exits 0
exec omni --config settings.json agents find nomatch
! stdout .

-- settings.json --
{}

-- bin/npx --
#!/bin/sh
if [ "$1" = "skills" ] && [ "$2" = "find" ]; then
  shift 2
  for arg; do
    [ "$arg" = "nomatch" ] && exit 0
  done
  printf '\033[32mowner/repo@skill-name  12.3K installs\033[0m\n'
  printf '  \xe2\x94\x94 https://github.com/owner/repo\n'
  printf 'other-owner/other-repo@other-skill  456 installs\n'
  exit 0
fi
if [ "$1" = "skills" ] && [ "$2" = "add" ]; then
  case "$3" in
    fail/*) printf 'error: package not found\n' >&2; exit 1 ;;
  esac
  exit 0
fi
exit 1
