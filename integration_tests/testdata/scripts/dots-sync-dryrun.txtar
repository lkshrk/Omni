# omni dots sync --dry-run with no entries reports "Dry-run"
# @requires: stow
env HOME=$WORK
exec omni --config settings.json dots sync --dry-run
stdout 'Dry-run'

-- settings.json --
{"host_settings":{"testhost":{"dots_repo":"~/dotfiles"}},"hosts":{"testhost":[]},"groups":[{"name":"testhost","special":"host"}]}

-- dotfiles/dotfiles/.keep --
