# omni tools upgrade --all upgrades every outdated cached tool and clears outdated state
exec chmod 755 bin/brew
env PATH=$WORK/bin:$PATH

exec omni-seed-cache ripgrep system ripgrep 14.0.0 15.0.0 brew
exec omni-seed-cache fd system fd 9.0.0 10.0.0 brew
exec omni --config settings.json tools upgrade --all
stdout 'upgrading ripgrep'
stdout 'upgraded: ripgrep \(system\)'
stdout 'upgrading fd'
stdout 'upgraded: fd \(system\)'
exec test -f .omni-cache/fake-brew/ripgrep-upgraded
exec test -f .omni-cache/fake-brew/fd-upgraded

exec omni --config settings.json tools list --state outdated --format json
stdout '^\[\]$'

-- bin/brew --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
  upgrade)
    : > "$state/$2"
    : > "$state/$2-upgraded"
    echo "2.0.0" > "$state/$2.version"
    ;;
  list)
    shift
    if [ "${1:-}" = "--versions" ]; then
      shift
      if [ "${1:-}" = "--cask" ]; then
        shift
      fi
      pkg="${1:-}"
      if [ -f "$state/$pkg" ]; then
        version="2.0.0"
        if [ -f "$state/$pkg.version" ]; then
          version="$(cat "$state/$pkg.version")"
        fi
        echo "$pkg $version"
        exit 0
      fi
    fi
    exit 1
    ;;
  info)
    echo '{"formulae":[],"casks":[]}'
    ;;
  outdated)
    formulae=""
    for pkg in ripgrep fd; do
      if [ ! -f "$state/$pkg-upgraded" ]; then
        if [ -n "$formulae" ]; then
          formulae="$formulae,"
        fi
        case "$pkg" in
          ripgrep) latest="15.0.0" ;;
          fd) latest="10.0.0" ;;
        esac
        formulae="${formulae}{\"name\":\"$pkg\",\"current_version\":\"$latest\"}"
      fi
    done
    echo "{\"formulae\":[$formulae],\"casks\":[]}"
    ;;
esac

-- settings.json --
{
  "hosts": { "testhost": [] },
  "tools": {
    "ripgrep": { "provider": "system", "install_with": "brew" },
    "fd": { "provider": "system", "install_with": "brew" }
  },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["ripgrep", "fd"] }
  ]
}
