# omni tools upgrade --all upgrades every outdated cached tool and clears outdated state
exec chmod 755 bin/brew
env PATH=$WORK/bin:$PATH

exec omni-seed-cache ripgrep system ripgrep 14.0.0 15.0.0 brew
exec omni-seed-cache fd system fd 9.0.0 10.0.0 brew
exec omni --config settings.json tools upgrade --all
stdout 'upgrading ripgrep \(15.0.0\)'
stdout 'upgraded: ripgrep \(15.0.0\) \(system\)'
stdout 'upgrading fd \(10.0.0\)'
stdout 'upgraded: fd \(10.0.0\) \(system\)'
exec test -f .omni-cache/fake-brew/ripgrep-upgraded
exec test -f .omni-cache/fake-brew/fd-upgraded

exec omni --config settings.json tools list --state outdated --format json
stdout '^\[\]$'

-- bin/brew --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
	  upgrade)
	    shift
	    if [ "${1:-}" = "--formula" ] || [ "${1:-}" = "--cask" ]; then
	      shift
	    fi
	    : > "$state/$1"
	    : > "$state/$1-upgraded"
	    echo "2.0.0" > "$state/$1.version"
	    ;;
	  leaves)
	    if [ "${2:-}" = "--installed-on-request" ]; then
	      for pkg in ripgrep fd; do
	        [ -f "$state/$pkg" ] && echo "$pkg"
	      done
	    fi
	    ;;
	  list)
	    shift
	    if [ "${1:-}" = "--cask" ]; then
	      exit 0
	    fi
	    if [ "${1:-}" = "--versions" ]; then
	      shift
	      if [ "${1:-}" = "--cask" ]; then
	        shift
	      fi
	      found=0
	      for pkg in "$@"; do
	        if [ -f "$state/$pkg" ]; then
	          version="2.0.0"
	          if [ -f "$state/$pkg.version" ]; then
	            version="$(cat "$state/$pkg.version")"
	          fi
	          echo "$pkg $version"
	          found=1
	        fi
	      done
	      [ "$found" -eq 1 ] && exit 0
	    fi
	    exit 1
	    ;;
  info)
    echo '{"formulae":[],"casks":[]}'
    ;;
  outdated)
    formulae=""
    for pkg in ripgrep fd; do
      if [ ! -f "$state/$pkg-upgraded" ]; then
        if [ -n "$formulae" ]; then
          formulae="$formulae,"
        fi
        case "$pkg" in
          ripgrep) latest="15.0.0" ;;
          fd) latest="10.0.0" ;;
        esac
        formulae="${formulae}{\"name\":\"$pkg\",\"current_version\":\"$latest\"}"
      fi
    done
    echo "{\"formulae\":[$formulae],\"casks\":[]}"
    ;;
esac

-- settings.json --
{
  "version": 6,
  "hosts": { "testhost": [] },
  "tools": {
    "ripgrep": { "providers": [{ "provider": "brew" }] },
    "fd": { "providers": [{ "provider": "brew" }] }
  },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["ripgrep", "fd"] }
  ]
}
