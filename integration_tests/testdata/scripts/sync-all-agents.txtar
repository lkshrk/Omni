# `tools sync --all` claims unmanaged agent resources and restores missing manifest packages after tools.
chmod 0755 $WORK/bin/claude
env PATH=$WORK/bin:$PATH
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --yes --config settings.json tools sync --all
stdout 'importing unmanaged skills…'
stdout 'importing unmanaged mcp servers…'
stdout 'importing unmanaged plugins…'
stdout 'restoring skills…'
stdout 'restoring mcp servers…'
stdout 'restoring plugins…'
stdout 'skills import: 1 added, 0 updated'
stdout '\+ o/stray'
stdout 'mcp import: 1 claimed'
stdout '^skills: 2 installed, 0 failed$'
stdout 'Agents sync complete — 2 imported, 2 skills installed, 0 mcp servers installed, 0 plugins installed, 0 failed, 6 warnings\.'

grep '"name": "stray-srv"' settings.json

exec grep 'o/stray' settings.json
exec sh -c 'test -L '"$WORK"'/home/.codex/skills/stray && echo adopted'
stdout adopted
exists $WORK/home/.agents/skills/stray/SKILL.md
exists $WORK/home/.codex/skills/one/SKILL.md

exec omni --yes --config agents-disabled.json tools sync --all
stdout 'Sync all complete'
! stdout 'importing unmanaged skills'
! stdout 'restoring skills'
! stdout 'Agents sync complete'

-- settings.json --
{"version":20,"settings":{"agents_use":["codex"]},"hosts":{"testhost":[]},"groups":[{"name":"testhost","special":"host"}],"agents":{"packages":[{"source":"./source-one"}]}}

-- agents-disabled.json --
{"version":20,"settings":{"agents_use":["codex"]},"hosts":{"testhost":[]},"groups":[{"name":"testhost","special":"host"}],"host_settings":{"testhost":{"agents_disabled":true}},"agents":{"packages":[{"source":"./source-one"}]}}

-- source-one/skills/one/SKILL.md --
---
name: one
description: Manifest package restored by sync --all.
---

one

-- home/.agents/.skill-lock.json --
{"version":3,"skills":{"stray":{"source":"o/stray","sourceType":"github","sourceUrl":"https://github.com/o/stray","skillFolderHash":"abc","installedAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:00:00Z"}}}

-- home/.agents/skills/stray/SKILL.md --
---
name: stray
description: Installed by another CLI, claimed by sync --all.
---

stray

-- home/.claude.json --
{"mcpServers":{"stray-srv":{"command":"npx","args":["-y","stray-srv"]}}}

-- bin/claude --
#!/bin/sh
set -eu
exit 0
