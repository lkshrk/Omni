# doctor surfaces the "Agent features" check and reflects per-feature and
# master agents_disabled gating in its skills/mcp/plugins detail groups.
# --format json is used since the detail-group items (the actual
# "disabled (...)" lines) are only present in JSON output; text output only
# prints the check's top-level summary message.

# 1. default config: agent features check is present in the checks list
exec omni --config settings.json doctor --format json
stdout '"label":"Agent features"'

# 2. master agents_disabled short-circuits the whole check
exec omni --config agents-disabled.json doctor --format json
stdout 'disabled \(agents_disabled\)'

# 3. mcp_disabled shows up in the mcp servers detail group
exec omni --config mcp-disabled.json doctor --format json
stdout 'disabled \(mcp_disabled\)'

-- settings.json --
{}

-- agents-disabled.json --
{"host_settings":{"testhost":{"agents_disabled":true}}}

-- mcp-disabled.json --
{"host_settings":{"testhost":{"mcp_disabled":true}}}
