# omni tools upgrade --all applies missing-metadata quarantine across providers
exec omni-seed-cache apt-tool apt apt-tool 1.0.0 2.0.0 apt
exec omni-seed-cache apk-tool apk apk-tool 1.0.0 2.0.0 apk
exec omni-seed-cache brew-tool brew brew-tool 1.0.0 2.0.0 brew
exec omni-seed-cache dnf-tool dnf dnf-tool 1.0.0 2.0.0 dnf
exec omni-seed-cache pacman-tool pacman pacman-tool 1.0.0 2.0.0 pacman
exec omni-seed-cache zypper-tool zypper zypper-tool 1.0.0 2.0.0 zypper
exec omni-seed-cache bun-tool bun bun-tool 1.0.0 2.0.0 bun
exec omni-seed-cache npm-tool npm npm-tool 1.0.0 2.0.0 npm
exec omni-seed-cache pnpm-tool pnpm pnpm-tool 1.0.0 2.0.0 pnpm
exec omni-seed-cache uv-tool uv uv-tool 1.0.0 2.0.0 uv
exec omni-seed-cache pip3-tool pip pip3-tool 1.0.0 2.0.0 pip3
exec omni-seed-cache pip-tool pip pip-tool 1.0.0 2.0.0 pip
exec omni-mark-outdated-refresh-fresh

exec omni --config settings.json tools list --state blocked-metadata --format json
stdout '"name":"apt-tool"'
stdout '"name":"apk-tool"'
stdout '"name":"brew-tool"'
stdout '"name":"dnf-tool"'
stdout '"name":"pacman-tool"'
stdout '"name":"zypper-tool"'
stdout '"name":"bun-tool"'
stdout '"name":"npm-tool"'
stdout '"name":"pnpm-tool"'
stdout '"name":"uv-tool"'
stdout '"name":"pip3-tool"'
stdout '"name":"pip-tool"'

exec omni --config settings.json tools upgrade --all
stdout 'skipped: apt-tool \(2.0.0\) \(apt\): update quarantined'
stdout 'skipped: apk-tool \(2.0.0\) \(apk\): update quarantined'
stdout 'skipped: brew-tool \(2.0.0\) \(brew\): update quarantined'
stdout 'skipped: dnf-tool \(2.0.0\) \(dnf\): update quarantined'
stdout 'skipped: pacman-tool \(2.0.0\) \(pacman\): update quarantined'
stdout 'skipped: zypper-tool \(2.0.0\) \(zypper\): update quarantined'
stdout 'skipped: bun-tool \(2.0.0\) \(bun\): update quarantined'
stdout 'skipped: npm-tool \(2.0.0\) \(npm\): update quarantined'
stdout 'skipped: pnpm-tool \(2.0.0\) \(pnpm\): update quarantined'
stdout 'skipped: uv-tool \(2.0.0\) \(uv\): update quarantined'
stdout 'skipped: pip3-tool \(2.0.0\) \(pip\): update quarantined'
stdout 'skipped: pip-tool \(2.0.0\) \(pip\): update quarantined'
stdout '12 updates quarantined\.'

-- settings.json --
{
  "version": 7,
  "settings": {
    "update_quarantine": "2d"
  },
  "hosts": { "testhost": [] },
  "tools": {
    "apt-tool": { "providers": [{ "provider": "apt" }] },
    "apk-tool": { "providers": [{ "provider": "apk" }] },
    "brew-tool": { "providers": [{ "provider": "brew" }] },
    "dnf-tool": { "providers": [{ "provider": "dnf" }] },
    "pacman-tool": { "providers": [{ "provider": "pacman" }] },
    "zypper-tool": { "providers": [{ "provider": "zypper" }] },
    "bun-tool": { "providers": [{ "provider": "bun" }] },
    "npm-tool": { "providers": [{ "provider": "npm" }] },
    "pnpm-tool": { "providers": [{ "provider": "pnpm" }] },
    "uv-tool": { "providers": [{ "provider": "uv" }] },
    "pip3-tool": { "providers": [{ "provider": "pip" }] },
    "pip-tool": { "providers": [{ "provider": "pip" }] }
  },
  "groups": [
    {
      "name": "testhost",
      "special": "host",
      "tools": [
        "apt-tool",
        "apk-tool",
        "brew-tool",
        "dnf-tool",
        "pacman-tool",
        "zypper-tool",
        "bun-tool",
        "npm-tool",
        "pnpm-tool",
        "uv-tool",
        "pip3-tool",
        "pip-tool"
      ]
    }
  ]
}
