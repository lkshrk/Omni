# omni reconcile --yes shows the target version when upgrading outdated tools
exec chmod 755 bin/brew
env PATH=$WORK/bin:$PATH

exec omni-seed-cache ripgrep system ripgrep 14.0.0 15.0.0 brew
exec omni --yes --config settings.json reconcile --skip-privileged
stdout 'upgrading ripgrep \(15.0.0\)'
stdout 'done: ripgrep \(15.0.0\) \(system\)'
stdout 'Reconcile complete .* 0 installed, 0 added to config, 1 upgraded'
exec test -f .omni-cache/fake-brew/ripgrep-upgraded

-- bin/brew --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"

version_for() {
  if [ -f "$state/$1-upgraded" ]; then
    echo "15.0.0"
  else
    echo "14.0.0"
  fi
}

case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
  upgrade)
    shift
    if [ "${1:-}" = "--formula" ] || [ "${1:-}" = "--cask" ]; then
      shift
    fi
    : > "$state/$1-upgraded"
    ;;
  leaves)
    if [ "${2:-}" = "--installed-on-request" ]; then
      echo "ripgrep"
    fi
    ;;
  list)
    shift
    if [ "${1:-}" = "--cask" ]; then
      exit 0
    fi
    if [ "${1:-}" = "--versions" ]; then
      shift
      if [ "${1:-}" = "--cask" ]; then
        shift
      fi
      found=0
      for pkg in "$@"; do
        if [ "$pkg" = "ripgrep" ]; then
          printf 'ripgrep %s\n' "$(version_for ripgrep)"
          found=1
        fi
      done
      [ "$found" -eq 1 ] && exit 0
    fi
    exit 1
    ;;
  info)
    if [ "${2:-}" = "--json=v2" ] && [ "${3:-}" = "--installed" ]; then
      printf '{"formulae":[{"name":"ripgrep","full_name":"ripgrep","desc":"search recursively","installed":[{"version":"%s","installed_on_request":true}]}],"casks":[]}\n' "$(version_for ripgrep)"
      exit 0
    fi
    printf '{"formulae":[],"casks":[]}\n'
    ;;
  outdated)
    if [ ! -f "$state/ripgrep-upgraded" ]; then
      printf '{"formulae":[{"name":"ripgrep","current_version":"15.0.0"}],"casks":[]}\n'
    else
      printf '{"formulae":[],"casks":[]}\n'
    fi
    ;;
esac

-- settings.json --
{
  "hosts": { "testhost": ["base"] },
  "tools": {
    "ripgrep": { "provider": "system", "install_with": "brew" }
  },
  "groups": [
    { "name": "testhost", "special": "host" },
    { "name": "base", "tools": ["ripgrep"] }
  ]
}
