# Status compares manifest, canonical store, and targets while suggesting repairs.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents skills sync
stdout '^1 installed, 0 failed$'

exec omni --config settings.json agents skills status ./source
stdout '^\./source$'
stdout 'manifest:  managed'
stdout 'agents:    claude-code, codex'
stdout 'skills:    demo'
stdout 'claude-code  owned-link .* omni''s link'
stdout 'codex  owned-link'

rm $WORK/home/.claude/skills/demo
mkdir $WORK/home/.claude/skills/demo
cp foreign/SKILL.md $WORK/home/.claude/skills/demo/SKILL.md
exec omni --config settings.json agents skills status ./source
stdout 'claude-code  drifted .* content differs from the package'
stdout 'agents skills resolve'

exec omni --config settings.json agents skills status ./source@demo
stdout 'skills:    demo'
! exec omni --config settings.json agents skills status ./source@absent
stderr 'is not part of package'

-- settings.json --
{"version":20,"settings":{"agents_use":["claude-code","codex"]},"agents":{"packages":[{"source":"./source"}]}}

-- source/skills/demo/SKILL.md --
---
name: demo
description: Native skills status test.
---

demo

-- foreign/SKILL.md --
---
name: demo
description: Another tool's copy of the same skill.
---

foreign demo

-- home/.claude/.keep --
-- home/.codex/.keep --
