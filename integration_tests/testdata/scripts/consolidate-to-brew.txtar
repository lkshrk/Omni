# omni tools consolidate --to brew with an empty config prints "All tools already on brew."
exec omni --config settings.json hosts ensure testhost
exec omni --config settings.json tools consolidate --to brew
stdout 'All tools already on brew'

# dry-run also works with no tools to migrate
exec omni --config settings.json tools consolidate --to brew --dry-run
stdout 'Nothing to migrate'

-- settings.json --
{}
