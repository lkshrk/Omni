# bootstrap offers the legacy agent-skills import when a lockfile package is
# missing from the manifest. Declining leaves the legacy CLI-managed install
# untouched; --import-skills adopts it without prompting.
env HOME=$WORK/home
env XDG_STATE_HOME=
env XDG_DATA_HOME=$WORK/data

stdin decline-input

exec omni --config settings.json bootstrap
stdout 'Config already exists at settings.json'
stdout 'Import 1 existing agent skill package\(s\)\? \(adopts legacy CLI-managed installs\) \[Y/n\] n'
! stdout 'added, 0 updated'
! exec grep 'o/demo' settings.json
exec sh -c 'test -d '"$WORK"'/home/.agents/skills/demo && test ! -L '"$WORK"'/home/.agents/skills/demo && echo legacy-intact'
stdout 'legacy-intact'

stdin import-input

exec omni --config settings.json bootstrap --import-skills
stdout '1 added, 0 updated, 0 unchanged'
stdout '\+ o/demo'
! stdout 'Import 1 existing agent skill package'

exec grep 'o/demo' settings.json
stdout 'o/demo'

# The legacy directory and the agent's skills directory are now Omni-owned
# links into the canonical package store.
exec sh -c 'test -L '"$WORK"'/home/.agents/skills/demo && echo legacy-adopted'
stdout 'legacy-adopted'
exec sh -c 'test -L '"$WORK"'/home/.codex/skills/demo && echo target-linked'
stdout 'target-linked'
exists $WORK/home/.agents/skills/demo/SKILL.md

-- decline-input --
n
n
n

-- import-input --
n
n

-- settings.json --
{
  "version": 20,
  "settings": {"agents_use": ["codex"]},
  "hosts": {"testhost": []},
  "groups": [
    {"name": "testhost", "special": "host"}
  ]
}

-- home/.agents/.skill-lock.json --
{"version":3,"skills":{"demo":{"source":"o/demo","sourceType":"github","sourceUrl":"https://github.com/o/demo","skillFolderHash":"abc","installedAt":"2026-01-01T00:00:00Z","updatedAt":"2026-01-01T00:00:00Z"}}}

-- home/.agents/skills/demo/SKILL.md --
---
name: demo
description: A legacy CLI-managed skill.
---

demo
