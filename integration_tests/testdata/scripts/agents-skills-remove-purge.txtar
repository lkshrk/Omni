# --purge undeclares the package and removes its unreferenced installs without touching bystanders.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents skills sync
stdout '^2 installed, 0 failed$'
exists $WORK/home/.codex/skills/gone/SKILL.md
exists $WORK/home/.codex/skills/stays/SKILL.md

exec omni --config settings.json agents skills remove ./going --purge
stdout 'uninstalled ./going'
stdout 'removed ./going from manifest'

! exists $WORK/home/.codex/skills/gone
! grep '"source": "./going"' settings.json

exists $WORK/home/.codex/skills/stays/SKILL.md
grep '"source": "./staying"' settings.json
exec omni --config settings.json agents skills sync --dry-run
! stdout 'install ./going'
stdout 'install ./staying all discovered skills for targets codex'

exec omni --config unsynced.json agents skills remove ./never --purge
stdout 'nothing installed for ./never'
stdout 'removed ./never from manifest'

-- settings.json --
{"version":20,"settings":{"agents_use":["codex"]},"agents":{"packages":[{"source":"./going"},{"source":"./staying"}]}}

-- unsynced.json --
{"version":20,"settings":{"agents_use":["codex"]},"agents":{"packages":[{"source":"./never"}]}}

-- never/skills/never/SKILL.md --
---
name: never
description: Declared but never synced on this host.
---

never

-- going/skills/gone/SKILL.md --
---
name: gone
description: Purged by remove --purge.
---

gone

-- staying/skills/stays/SKILL.md --
---
name: stays
description: Bystander package.
---

stays
