# Fresh stub ports cover endpoint-keyed cache invalidation; internal/app/skill_find_test.go covers same-endpoint TTL hits.
env HOME=$WORK/home
env OMNI_TEST_CATALOG_LOG=$WORK/catalog.log

exec omni-with-skills-catalog --config settings.json agents find foo
stdout '^owner/repo  \(review\)  12 installs$'
stdout '^owner/other  \(other\)  3 installs$'
! stdout 'owner/repo\.git'
grep -count=1 '^limit=10&q=foo$' $WORK/catalog.log

exec omni-with-skills-catalog --config settings.json agents find foo --owner acme
stdout '^acme/skills  \(acme-tool\)  5 installs$'
! stdout 'owner/repo'
grep -count=1 '^limit=10&owner=acme&q=foo$' $WORK/catalog.log

exec omni-with-skills-catalog --config settings.json agents find foo
stdout '^owner/repo  \(review\)  12 installs$'
grep -count=2 '^limit=10&q=foo$' $WORK/catalog.log

-- settings.json --
{"version":20,"settings":{"agents_use":["codex"]}}
