# Real Codex integration: a credential-free custom Responses provider lets the
# real client initialize Omni's MCP server and emit its configured header.
# @requires: codex
env HOME=$WORK/home
env CODEX_HOME=$WORK/home/.codex
mkdir $WORK/home
mkdir $CODEX_HOME

exec omni-assert-codex-mcp-header settings.json headers-codex-wire X-Codex-Probe codex-wire-value
stdout 'captured header X-Codex-Probe'

-- settings.json --
{
  "version": 18,
  "agents": {
    "mcp_servers": [
      {
        "name": "headers-codex-wire",
        "transport": "http",
        "url": "STUB_SERVER_URL/mcp",
        "headers": {
          "X-Codex-Probe": "codex-wire-value"
        },
        "agents": ["codex"]
      }
    ]
  }
}
