# successful install, upgrade, switch, and delete use fake providers end-to-end
exec chmod 755 bin/brew
exec chmod 755 bin/pip3
env PATH=$WORK/bin:$PATH

exec omni --config settings.json hosts ensure testhost
exec omni --config settings.json tools set black --provider python --install-with pip3
stdout 'Set logical tool "black"'
exec omni --config settings.json groups move-tool testhost black
stdout 'Moved "black" to group "testhost"'

exec omni --config settings.json tools install black --provider python
stdout 'installed black'
exec test -f .omni-cache/fake-pip/black

exec omni --config settings.json tools upgrade black --provider python
stdout 'upgraded black'
exec test -f .omni-cache/fake-pip/black-upgraded

exec omni --config settings.json tools switch black --from python --to brew
stdout 'switched black'
stdout 'python'
stdout 'brew'
exec test -f .omni-cache/fake-brew/black
! exec test -f .omni-cache/fake-pip/black
exec grep '"provider": "system"' settings.json
stdout '"provider": "system"'
exec grep '"install_with": "brew"' settings.json
stdout '"install_with": "brew"'

exec omni -y --config settings.json tools delete black --provider brew
stdout 'deleted black'
exec test ! -f .omni-cache/fake-brew/black
! exec grep '"black"' settings.json

-- bin/brew --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
  install)
    : > "$state/$2"
    ;;
  uninstall)
    rm -f "$state/$2"
    ;;
  upgrade)
    : > "$state/$2-upgraded"
    ;;
  list)
    shift
    if [ "${1:-}" = "--versions" ]; then
      shift
      if [ "${1:-}" = "--cask" ]; then
        shift
      fi
      pkg="${1:-}"
      if [ -f "$state/$pkg" ]; then
        echo "$pkg 1.0.0"
        exit 0
      fi
    fi
    exit 1
    ;;
  info)
    echo '{"formulae":[],"casks":[]}'
    ;;
esac

-- bin/pip3 --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-pip"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "pip 25.0"
    ;;
  install)
    if [ "${2:-}" = "--upgrade" ]; then
      : > "$state/$3"
      : > "$state/$3-upgraded"
    else
      : > "$state/$2"
    fi
    ;;
  uninstall)
    rm -f "$state/$3"
    ;;
  show)
    if [ -f "$state/$2" ]; then
      printf 'Name: %s\nVersion: 1.0.0\nSummary: fake package\n' "$2"
      exit 0
    fi
    exit 1
    ;;
  list)
    echo '[]'
    ;;
esac

-- settings.json --
{}
