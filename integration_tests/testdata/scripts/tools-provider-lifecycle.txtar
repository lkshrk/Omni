# successful install, upgrade, reinstall, and delete use fake providers end-to-end
exec chmod 755 bin/brew
exec chmod 755 bin/pip3
env PATH=$WORK/bin:$PATH

exec omni --config settings.json hosts ensure testhost
exec omni --config settings.json tools set black --provider pip
stdout 'Set logical tool "black"'
exec omni --config settings.json groups move-tool testhost black
stdout 'Moved "black" to group "testhost"'

exec omni --config settings.json tools install black --provider pip
stdout 'installed black'
exec test -f .omni-cache/fake-pip/black

exec omni --config settings.json tools upgrade black --provider pip
stdout 'upgraded black'
exec test -f .omni-cache/fake-pip/black-upgraded

exec omni --config settings.json tools reinstall black --from pip --to brew
stdout 'reinstalled black'
stdout 'pip'
stdout 'brew'
exec test -f .omni-cache/fake-brew/black
! exec test -f .omni-cache/fake-pip/black
exec grep '"provider": "brew"' settings.json
stdout '"provider": "brew"'

exec omni -y --config settings.json tools delete black --provider brew
stdout 'deleted black'
exec test ! -f .omni-cache/fake-brew/black
! exec grep '"black"' settings.json

-- bin/brew --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
  install)
    : > "$state/$2"
    ;;
  uninstall)
    rm -f "$state/$2"
    ;;
	  upgrade)
	    shift
	    if [ "${1:-}" = "--formula" ] || [ "${1:-}" = "--cask" ]; then
	      shift
	    fi
	    : > "$state/$1-upgraded"
	    ;;
	  leaves)
	    if [ "${2:-}" = "--installed-on-request" ]; then
	      for pkg in "$state"/*; do
	        [ -f "$pkg" ] || continue
	        case "$pkg" in
	          *-upgraded|*.version) continue ;;
	        esac
	        basename "$pkg"
	      done
	    fi
	    ;;
	  list)
	    shift
	    if [ "${1:-}" = "--cask" ]; then
	      exit 0
	    fi
	    if [ "${1:-}" = "--versions" ]; then
	      shift
	      if [ "${1:-}" = "--cask" ]; then
	        shift
	      fi
	      found=0
	      for pkg in "$@"; do
	        if [ -f "$state/$pkg" ]; then
	          echo "$pkg 1.0.0"
	          found=1
	        fi
	      done
	      [ "$found" -eq 1 ] && exit 0
	    fi
	    exit 1
	    ;;
	  info)
	    echo '{"formulae":[],"casks":[]}'
	    ;;
	  update)
	    ;;
	  outdated)
	    echo '{"formulae":[],"casks":[]}'
	    ;;
	esac

-- bin/pip3 --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-pip"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "pip 25.0"
    ;;
  install)
    if [ "${2:-}" = "--upgrade" ]; then
      : > "$state/$3"
      : > "$state/$3-upgraded"
    else
      : > "$state/$2"
    fi
    ;;
  uninstall)
    rm -f "$state/$3"
    ;;
  show)
    if [ -f "$state/$2" ]; then
      printf 'Name: %s\nVersion: 1.0.0\nSummary: fake package\n' "$2"
      exit 0
    fi
    exit 1
    ;;
  list)
    echo '[]'
    ;;
esac

-- settings.json --
{}
