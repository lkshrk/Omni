# group lifecycle commands persist config changes through the real CLI
exec omni --config settings.json hosts ensure testhost

exec omni --config settings.json groups create dev
stdout 'Created group "dev"'
exec omni --config settings.json groups
stdout 'dev'
stdout '0 tool'

exec omni --config settings.json hosts add-group testhost dev
exec omni --config settings.json groups rename dev work
stdout 'Renamed group "dev" to "work"'
exec omni --config settings.json hosts list
stdout 'work'
! stdout 'dev'

exec omni --config settings.json tools add ripgrep --provider brew --group testhost
exec omni --config settings.json groups move-tool work ripgrep
stdout 'Moved "ripgrep" to group "work"'
exec omni --config settings.json groups ignore-tool work ripgrep
stdout 'Ignored "ripgrep" in group "work"'
exec cat settings.json
stdout '"ignore"'
stdout '"ripgrep"'
exec omni --config settings.json groups unignore-tool work ripgrep
stdout 'Unignored "ripgrep" in group "work"'
exec omni --config settings.json groups remove-tool work ripgrep
stdout 'Removed "ripgrep" from group "work"'
exec omni --config settings.json groups move-tool work ripgrep
stdout 'Moved "ripgrep" to group "work"'
exec omni --config settings.json groups
stdout 'work'
stdout '1 tool'

exec omni -y --config settings.json groups delete work --move-to testhost
stdout 'Deleted group "work"'
exec omni --config settings.json groups
stdout 'testhost'
stdout '1 tool'
! stdout 'work'

-- settings.json --
{}
