# Identity drift is reported without overwrite and settled only with an explicit side.
chmod 0755 $WORK/bin/claude
env PATH=$WORK/bin:$PATH
env HOME=$WORK/home

exec omni --config settings.json agents mcp list
stdout 'srv\s+http\s+claude-code\(drift\)'

exec omni --config settings.json agents mcp sync
stdout 'drift: claude-code/srv: drifted on claude-code \(url differ'
stdout 'omni agents mcp resolve'
! stdout 'installed: claude-code/srv'

exec omni --config settings.json doctor --format json
stdout 'srv: drifted on claude-code \(url'

exec omni --config settings.json agents mcp resolve srv --use-managed --dry-run
stdout 'would reinstall srv on claude-code'
! grep 'mcp remove' $WORK/.omni-cache/claude-calls.log

exec omni --yes --config settings.json agents mcp resolve srv --use-managed
grep 'mcp remove -s user srv' $WORK/.omni-cache/claude-calls.log
grep 'mcp add -s user srv --transport http https://mcp.example.com' $WORK/.omni-cache/claude-calls.log

exec omni --config settings.json agents mcp resolve srv --use-local
stdout 'adopt srv'
stdout 'into the manifest'
grep 'https://hijacked.example.com' settings.json

! exec omni --config settings.json agents mcp resolve srv --use-local
stderr 'not drifted on any target agent'

-- settings.json --
{"version":20,"agents":{"mcp_servers":[{"name":"srv","transport":"http","url":"https://mcp.example.com","agents":["claude-code"]}]}}

-- home/.claude.json --
{"mcpServers":{"srv":{"type":"http","url":"https://hijacked.example.com"}}}

-- bin/claude --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/claude-calls.log"
exit 0
