# dots delete --keep-local=false removes both the repo package and local link
# @requires: stow
env HOME=$WORK/home
mkdir $WORK/home
mkdir $WORK/home/.config
exec git init $WORK/home/dotfiles
exec git -C $WORK/home/dotfiles config user.email t@t.com
exec git -C $WORK/home/dotfiles config user.name T
exec git -C $WORK/home/dotfiles commit --allow-empty -m init
exec omni --config settings.json dots sync
exec omni -y --config settings.json dots delete nvim --keep-local=false
stdout 'deleted dots entry "nvim"'
! exists home/.config/nvim
exec cat home/dotfiles.bkp/.config/nvim/init.lua
stdout 'vim.opt.number = true'
! exists home/dotfiles/dotfiles/nvim
exec omni --config settings.json dots list
stdout 'No dots entries'

-- settings.json --
{"host_settings":{"testhost":{"dots_repo":"~/dotfiles"}},"hosts":{"testhost":[]},"groups":[{"name":"testhost","special":"host","dots":[{"name":"nvim","path":"~/.config/nvim"}]}]}

-- home/dotfiles/dotfiles/nvim/.config/nvim/init.lua --
vim.opt.number = true
