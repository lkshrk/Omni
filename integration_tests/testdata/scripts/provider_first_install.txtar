# provider-first install: bootstrap provider (pip via brew) installs before dependent tool (ruff via pip)
exec chmod 755 bin/brew bin/pip3 bin/pip bin/apt bin/apk bin/dnf bin/pacman bin/zypper
env PATH=$WORK/bin:$PATH

exec omni --config settings.json hosts ensure testhost

# Run sync: pass 1 installs pip via brew, pass 2 installs ruff via pip.
exec omni --config settings.json tools sync
stdout 'done: pip \(brew\)'
stdout 'done: ruff \(pip\)'

# Verify brew recorded installing pip (sentinel file written by fake brew).
exec test -f .omni-cache/fake-brew/pip

# Verify pip recorded installing ruff (sentinel file written by fake pip).
exec test -f .omni-cache/fake-pip/ruff

-- bin/brew --
#!/bin/sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
  info)
    if [ "${2:-}" = "--json=v2" ] && [ "${3:-}" = "--installed" ]; then
      # Report pip as installed if the sentinel exists.
      if [ -f "$state/pip" ]; then
        printf '{"formulae":[{"name":"pip","full_name":"pip","desc":"Python package manager","installed":[{"version":"25.0","installed_on_request":true}]}],"casks":[]}\n'
      else
        printf '{"formulae":[],"casks":[]}\n'
      fi
      exit 0
    fi
    printf '{"formulae":[],"casks":[]}\n'
    ;;
  leaves)
    if [ "${2:-}" = "--installed-on-request" ]; then
      if [ -f "$state/pip" ]; then
        echo "pip"
      fi
    fi
    ;;
  list)
    shift
    if [ "${1:-}" = "--cask" ]; then
      exit 0
    fi
    if [ "${1:-}" = "--versions" ]; then
      shift
      if [ "${1:-}" = "--cask" ]; then
        shift
      fi
      found=0
      for pkg in "$@"; do
        case "$pkg" in
          pip)
            if [ -f "$state/pip" ]; then
              echo "pip 25.0"
              found=1
            fi
            ;;
        esac
      done
      [ "$found" -eq 1 ] && exit 0
    fi
    exit 1
    ;;
  update)
    ;;
  outdated)
    printf '{"formulae":[],"casks":[]}\n'
    ;;
  install)
    : > "$state/$2"
    ;;
  uninstall)
    rm -f "$state/$2"
    ;;
esac

-- bin/pip3 --
#!/bin/sh
set -eu
state="${OMNI_CACHE_DIR}/fake-pip"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "pip 25.0"
    ;;
  install)
    : > "$state/$2"
    ;;
  uninstall)
    rm -f "$state/$3"
    ;;
  show)
    if [ -f "$state/$2" ]; then
      printf 'Name: %s\nVersion: 0.1.0\nSummary: fake package\n' "$2"
      exit 0
    fi
    exit 1
    ;;
  list)
    echo '[]'
    ;;
esac

-- bin/pip --
#!/bin/sh
exit 1

-- bin/apt --
#!/bin/sh
exit 1

-- bin/apk --
#!/bin/sh
exit 1

-- bin/dnf --
#!/bin/sh
exit 1

-- bin/pacman --
#!/bin/sh
exit 1

-- bin/zypper --
#!/bin/sh
exit 1

-- settings.json --
{
  "version": 6,
  "settings": {
    "providers": [
      { "name": "pip", "provider": "brew" }
    ],
    "disabled_providers": ["node"]
  },
  "hosts": { "testhost": [] },
  "tools": {
    "ruff": { "providers": [{ "provider": "pip" }] }
  },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["ruff"] }
  ]
}
