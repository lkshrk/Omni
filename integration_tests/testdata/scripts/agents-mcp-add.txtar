# Targeting claude-code prevents host Codex binaries from affecting the fixture.
chmod 0755 $WORK/bin/claude
env PATH=$WORK/bin:$PATH
env HOME=$WORK/home
mkdir $WORK/home

exec omni --config settings.json agents mcp add --name myserver --transport stdio --command 'npx my-server' --agents claude-code
stdout 'added myserver'
exec omni --config settings.json agents mcp sync --dry-run
stdout -count=1 'would install: claude-code/myserver'

exec omni --config settings.json agents mcp add --name remote --transport http --url https://mcp.example.com --header 'X-Key: literal-value' --header 'X-Env: ${REMOTE_TOKEN}' --agents claude-code
stdout 'added remote'
exec grep '"X-Key": "literal-value"' settings.json
exec grep '"X-Env": "\${REMOTE_TOKEN}"' settings.json
exec grep -- '--header X-Key: literal-value' .omni-cache/claude-calls.log

! exec omni --config settings.json agents mcp add --name bad --transport http --url https://mcp.example.com --header missing-colon --agents claude-code
stderr 'must be NAME: VALUE'
! exec omni --config settings.json agents mcp add --name bad --transport http --url https://mcp.example.com --header 'X-Key: one' --header 'X-Key: two' --agents claude-code
stderr 'duplicate name "X-Key"'
! exec omni --config settings.json agents mcp add --name bad --transport stdio --command 'npx bad' --header 'X-Key: value' --agents claude-code
stderr '--header is not valid for stdio transport'
! exec omni --config settings.json agents mcp add --name invalid-header --transport http --url https://mcp.example.com --header 'Bad Name: value' --agents claude-code
stderr 'invalid HTTP header name'
! exec grep 'invalid-header' .omni-cache/claude-calls.log

exec omni --config settings.json agents mcp add --name myserver --transport stdio --command 'npx my-server' --agents claude-code
stdout 'added myserver'
exec omni --config settings.json agents mcp sync --dry-run
stdout -count=1 'would install: claude-code/myserver'

-- settings.json --
{}

-- bin/claude --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/claude-calls.log"
if [ "$1" = "mcp" ] && [ "$2" = "add" ]; then
  echo "added myserver"
  exit 0
fi
exit 1
