# omni sync --all --group places discovered tools directly into the named group with no reassignment prompt
exec chmod 755 bin/brew bin/apt bin/apk bin/dnf bin/pacman bin/zypper bin/pip bin/pip3
env PATH=$WORK/bin:$PATH

exec omni --yes --config settings.json tools sync --all --group dev
stdout 'claiming fzf'
stdout 'Sync all complete'
stdout '1 added to config'
exec grep '"fzf"' settings.json
stdout '"fzf"'
# tool must appear in dev group, not just machine group
exec grep '"name": "dev"' settings.json
stdout '"name": "dev"'
# no reassignment prompt (--group flag was set)
! stdout 'Move to a different group'
! stdout '\[a\]ll to same group'

-- bin/brew --
#!/bin/sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
	  info)
	    if [ "${2:-}" = "--json=v2" ] && [ "${3:-}" = "--installed" ]; then
	      printf '{"formulae":[{"name":"fzf","full_name":"fzf","desc":"fuzzy finder","installed":[{"version":"0.61.1","installed_on_request":true}]}],"casks":[]}\n'
	      exit 0
	    fi
	    printf '{"formulae":[],"casks":[]}\n'
	    ;;
	  leaves)
	    if [ "${2:-}" = "--installed-on-request" ]; then
	      echo "fzf"
	      echo "fd"
	    fi
	    ;;
	  list)
	    shift
	    if [ "${1:-}" = "--cask" ]; then
	      exit 0
	    fi
	    if [ "${1:-}" = "--versions" ]; then
	      shift
	      if [ "${1:-}" = "--cask" ]; then
	        shift
	      fi
	      found=0
	      for pkg in "$@"; do
	        case "$pkg" in
	          fzf)
	            echo "fzf 0.61.1"
	            found=1
	            ;;
	          fd)
	            echo "fd 10.2.0"
	            found=1
	            ;;
	        esac
	      done
	      [ "$found" -eq 1 ] && exit 0
	    fi
	    exit 1
	    ;;
	  update)
	    ;;
	  outdated)
	    printf '{"formulae":[],"casks":[]}\n'
	    ;;
	  install)
	    : > "$state/$2"
	    ;;
esac

-- bin/apt --
#!/bin/sh
exit 1

-- bin/apk --
#!/bin/sh
exit 1

-- bin/dnf --
#!/bin/sh
exit 1

-- bin/pacman --
#!/bin/sh
exit 1

-- bin/zypper --
#!/bin/sh
exit 1

-- bin/pip --
#!/bin/sh
exit 1

-- bin/pip3 --
#!/bin/sh
exit 1

-- settings.json --
{
  "version": 6,
  "settings": {
    "disabled_providers": ["node", "python"]
  },
  "hosts": { "testhost": [] },
	  "tools": {
	    "fd": { "providers": [{ "provider": "brew" }] }
	  },
	  "groups": [
	    { "name": "testhost", "special": "host", "tools": ["fd"] },
	    { "name": "dev", "tools": [] }
	  ]
}
