# dots ignore adds an ignore glob to an existing configured entry
exec omni --config settings.json dots ignore nvim '*.log'
stdout 'added ignore pattern'
stdout 'nvim'
exec cat settings.json
stdout '"ignore":'
stdout '"*.log"'

# Re-adding the same pattern is a no-op that keeps a single entry.
exec omni --config settings.json dots ignore nvim '*.log'
stdout 'added ignore pattern'
stdout 'nvim'

! exec omni --config settings.json dots ignore nvim '['
stderr 'invalid glob pattern'

-- settings.json --
{"host_settings":{"testhost":{"dots_repo":"~/dotfiles"}},"hosts":{"testhost":[]},"groups":[{"name":"testhost","special":"host","dots":[{"name":"nvim","path":"~/.config/nvim"}]}]}

-- dotfiles/dotfiles/.keep --
