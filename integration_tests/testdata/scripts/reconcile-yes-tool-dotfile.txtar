# omni reconcile --yes installs missing tools, repairs dotfile links, and commits dirty dotfiles
# @requires: stow
env HOME=$WORK/home
mkdir $WORK/home
mkdir $WORK/home/.config
exec chmod 755 bin/brew bin/apt bin/apk bin/dnf bin/pacman bin/zypper bin/pip bin/pip3
env PATH=$WORK/bin:$PATH

exec git init $WORK/home/dotfiles
exec git -C $WORK/home/dotfiles config user.email t@t.com
exec git -C $WORK/home/dotfiles config user.name T
exec git -C $WORK/home/dotfiles config commit.gpgsign false
exec git -C $WORK/home/dotfiles config tag.gpgsign false
exec git -C $WORK/home/dotfiles add dotfiles
exec git -C $WORK/home/dotfiles commit -m seed
exec cp changed/init.lua $WORK/home/dotfiles/dotfiles/nvim/.config/nvim/init.lua

exec omni --yes --config settings.json reconcile --skip-privileged -m 'dots: reconcile commit'
stdout 'syncing tools'
stdout 'Scanning system/brew… \(1/1\)'
stdout 'done: fd \(system\)'
stdout 'syncing dotfiles'
stdout 'committing dotfiles'
stdout 'Reconcile complete .* 1 installed, 0 added to config, 0 upgraded, .* dotfile op, dotfiles committed\.'
exec test -f .omni-cache/fake-brew/fd
exec grep 'reconciled config' $WORK/home/.config/nvim/init.lua
stdout 'reconciled config'
exec git -C $WORK/home/dotfiles log -1 --pretty=%s
stdout 'dots: reconcile commit'

-- bin/brew --
#!/bin/sh
set -eu
state="${OMNI_CACHE_DIR}/fake-brew"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "Homebrew 4.0.0"
    ;;
	  info)
	    if [ "${2:-}" = "--json=v2" ] && [ "${3:-}" = "--installed" ]; then
	      if [ -f "$state/fd" ]; then
	        printf '{"formulae":[{"name":"fd","full_name":"fd","desc":"find entries","installed":[{"version":"10.2.0","installed_on_request":true}]}],"casks":[]}\n'
	      else
	        printf '{"formulae":[],"casks":[]}\n'
	      fi
	      exit 0
	    fi
	    printf '{"formulae":[],"casks":[]}\n'
	    ;;
	  leaves)
	    if [ "${2:-}" = "--installed-on-request" ] && [ -f "$state/fd" ]; then
	      echo "fd"
	    fi
	    ;;
	  list)
	    shift
	    if [ "${1:-}" = "--cask" ]; then
	      exit 0
	    fi
	    if [ "${1:-}" = "--versions" ]; then
	      shift
	      if [ "${1:-}" = "--cask" ]; then
	        shift
	      fi
	      found=0
	      for pkg in "$@"; do
	        if [ "$pkg" = "fd" ] && [ -f "$state/fd" ]; then
	          echo "fd 10.2.0"
	          found=1
	        fi
	      done
	      [ "$found" -eq 1 ] && exit 0
	    fi
	    exit 1
	    ;;
	  update)
	    ;;
	  outdated)
	    printf '{"formulae":[],"casks":[]}\n'
	    ;;
	  install)
	    : > "$state/$2"
	    ;;
esac

-- bin/apt --
#!/bin/sh
exit 1

-- bin/apk --
#!/bin/sh
exit 1

-- bin/dnf --
#!/bin/sh
exit 1

-- bin/pacman --
#!/bin/sh
exit 1

-- bin/zypper --
#!/bin/sh
exit 1

-- bin/pip --
#!/bin/sh
exit 1

-- bin/pip3 --
#!/bin/sh
exit 1

-- settings.json --
{
  "settings": {
    "disabled_providers": ["node", "python"]
  },
  "host_settings": {
    "testhost": {
      "dots_repo": "~/dotfiles"
    }
  },
  "hosts": { "testhost": [] },
  "tools": {
    "fd": { "provider": "system", "install_with": "brew" }
  },
  "groups": [
    {
      "name": "testhost",
      "special": "host",
      "tools": ["fd"],
      "dots": [{ "name": "nvim", "path": "~/.config/nvim" }]
    }
  ]
}

-- home/dotfiles/dotfiles/nvim/.config/nvim/init.lua --
-- seed config

-- changed/init.lua --
-- reconciled config
