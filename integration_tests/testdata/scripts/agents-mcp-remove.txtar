# Targeting claude-code prevents host Codex binaries from affecting the fixture.
# Seed $HOME/.claude.json because RemoveMcpServer execs only when List reports the server installed.
chmod 0755 $WORK/bin/claude
env PATH=$WORK/bin:$PATH
env HOME=$WORK/home

exec omni --config settings.json agents mcp remove myserver
stdout 'removed myserver'
exec grep -q 'mcp remove -s user myserver' .omni-cache/claude-calls.log

exec omni --config settings.json agents mcp sync --dry-run
! stdout 'myserver'

! exec omni --config settings.json agents mcp remove not-in-manifest
stderr 'not-in-manifest.*not found in manifest'

-- settings.json --
{"agents":{"mcp_servers":[
  {"name":"myserver","transport":"stdio","command":"npx my-server","agents":["claude-code"]}
]}}

-- home/.claude.json --
{"mcpServers":{"myserver":{"type":"stdio","command":"npx","args":["my-server"]}}}

-- bin/claude --
#!/bin/sh
set -eu
mkdir -p "${OMNI_CACHE_DIR}"
echo "$*" >> "${OMNI_CACHE_DIR}/claude-calls.log"
if [ "$1" = "mcp" ] && [ "$2" = "remove" ]; then
  exit 0
fi
exit 1
