# Restore adopts byte-identical unmanaged skills and reports differing content as drift.
env HOME=$WORK/home
env XDG_DATA_HOME=$WORK/data

exec omni --config settings.json agents skills sync
stdout 'warn: adopted identical unmanaged copy at .*/home/\.codex/skills/one'
stdout '^2 installed, 0 failed$'
! stdout 'already exists for target'
stdout '~ drift: \./source-two: drifted'

exec sh -c 'test -L '"$WORK"'/home/.codex/skills/one && echo converged'
stdout converged
exists $WORK/home/.codex/skills/one/SKILL.md

exec sh -c 'test ! -L '"$WORK"'/home/.codex/skills/two && echo untouched'
stdout untouched
cmp $WORK/home/.codex/skills/two/SKILL.md foreign-two.md

exec omni --config settings.json agents skills sync
! stdout 'adopted identical unmanaged copy'
stdout '^2 installed, 0 failed$'
stdout '~ drift: \./source-two: drifted'
cmp $WORK/home/.codex/skills/two/SKILL.md foreign-two.md

-- settings.json --
{"version":20,"settings":{"agents_use":["codex"]},"agents":{"packages":[{"source":"./source-one"},{"source":"./source-two"}]}}

-- source-one/skills/one/SKILL.md --
---
name: one
description: Converged native test skill.
---

one

-- source-two/skills/two/SKILL.md --
---
name: two
description: Blocked native test skill.
---

two

-- home/.codex/skills/one/SKILL.md --
---
name: one
description: Converged native test skill.
---

one

-- home/.codex/skills/two/SKILL.md --
---
name: two
description: Another tool's copy, not ours.
---

two

-- foreign-two.md --
---
name: two
description: Another tool's copy, not ours.
---

two

