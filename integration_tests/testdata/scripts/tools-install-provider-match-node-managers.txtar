# tools install keeps concrete node-manager matches in priority order and skips ecosystem node
exec chmod 755 bin/bun bin/pnpm bin/npm
env PATH=$WORK/bin:$PATH

exec omni --config settings.json hosts ensure testhost
exec omni-with-npm-registry --config settings.json tools install prettier
stdout 'matched providers: prettier -> pnpm/prettier, npm/prettier, bun/prettier'
! stdout 'node/prettier'
stdout 'installed prettier \(pnpm\)'
exec test -f .omni-cache/fake-pnpm/prettier
! exec test -f .omni-cache/fake-npm/prettier
! exec test -f .omni-cache/fake-bun/prettier
exec omni-assert-tool-provider-list settings.json prettier pnpm npm bun

-- bin/bun --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-bun"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "1.2.0"
    ;;
  add)
    pkg=""
    for arg in "$@"; do
      case "$arg" in
        add|-g)
          ;;
        *)
          pkg="$arg"
          ;;
      esac
    done
    if [ -n "$pkg" ]; then
      : > "$state/$pkg"
      exit 0
    fi
    exit 1
    ;;
  pm)
    if [ "${2:-}" = "ls" ] && [ "${3:-}" = "-g" ]; then
      for entry in "$state"/*; do
        [ -f "$entry" ] || continue
        printf '+-- %s@1.0.0\n' "$(basename "$entry")"
      done
      exit 0
    fi
    exit 1
    ;;
  *)
    exit 1
    ;;
esac

-- bin/pnpm --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-pnpm"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "10.0.0"
    ;;
  add)
    pkg=""
    for arg in "$@"; do
      case "$arg" in
        add|-g)
          ;;
        *)
          pkg="$arg"
          ;;
      esac
    done
    if [ -n "$pkg" ]; then
      : > "$state/$pkg"
      exit 0
    fi
    exit 1
    ;;
  ls|list)
    pkg=""
    for arg in "$@"; do
      case "$arg" in
        ls|list|-g|--depth=0)
          ;;
        *)
          pkg="$arg"
          ;;
      esac
    done
    if [ -n "$pkg" ]; then
      if [ -f "$state/$pkg" ]; then
        printf '/fake\n+-- %s@1.0.0\n' "$pkg"
        exit 0
      fi
      exit 1
    fi
    for entry in "$state"/*; do
      [ -f "$entry" ] || continue
      printf '+-- %s@1.0.0\n' "$(basename "$entry")"
    done
    exit 0
    ;;
  *)
    exit 1
    ;;
esac

-- bin/npm --
#!/usr/bin/env sh
set -eu
state="${OMNI_CACHE_DIR}/fake-npm"
mkdir -p "$state"
case "${1:-}" in
  --version)
    echo "10.2.4"
    ;;
  install)
    pkg=""
    for arg in "$@"; do
      case "$arg" in
        install|-g)
          ;;
        *)
          pkg="$arg"
          ;;
      esac
    done
    if [ -n "$pkg" ]; then
      : > "$state/$pkg"
      exit 0
    fi
    exit 1
    ;;
  list|ls)
    pkg=""
    for arg in "$@"; do
      case "$arg" in
        list|ls|-g|--depth=0)
          ;;
        *)
          pkg="$arg"
          ;;
      esac
    done
    if [ -n "$pkg" ]; then
      if [ -f "$state/$pkg" ]; then
        printf '/fake\n+-- %s@1.0.0\n' "$pkg"
        exit 0
      fi
      exit 1
    fi
    for entry in "$state"/*; do
      [ -f "$entry" ] || continue
      printf '+-- %s@1.0.0\n' "$(basename "$entry")"
    done
    exit 0
    ;;
  *)
    exit 1
    ;;
esac

-- settings.json --
{
  "version": 7,
  "host_settings": {
    "testhost": {
      "provider_priority": ["pnpm", "npm", "bun"],
      "disabled_providers": ["brew", "python", "system", "pip"]
    }
  },
  "tools": {
    "prettier": {}
  },
  "hosts": { "testhost": [] },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["prettier"] }
  ]
}
