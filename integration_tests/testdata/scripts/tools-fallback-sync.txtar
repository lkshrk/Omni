# tools sync uses a configured fallback when native package availability is cached unavailable
exec chmod 755 bin/apt-get bin/brew
env PATH=$WORK/bin:$PATH

exec omni --config settings.json hosts ensure testhost
exec omni-seed-package-availability rg apt rg false 'no candidate'

exec omni --config settings.json tools sync
stdout 'installed: rg \(apt\)'
exec test -f .omni-cache/fallback/rg
exec grep '"status": "verified"' settings.json
stdout '"status": "verified"'

# A second sync should verify the fallback-owned binary and skip reinstall.
exec omni --config settings.json tools sync
stdout 'already installed: rg \(apt\)'

-- bin/apt-get --
#!/bin/sh
set -eu
case "${1:-}" in
  --version)
    echo "apt 2.0.0"
    ;;
  *)
    exit 1
    ;;
esac

-- bin/brew --
#!/bin/sh
if [ "${1:-}" = "tap" ]; then
  exit 0
fi
exit 1

-- settings.json --
{
  "version": 7,
  "settings": {
    "disabled_providers": ["brew", "npm", "pip"]
  },
  "tools": {
    "rg": {
      "providers": [{ "provider": "apt" }],
      "fallback": {
        "source": {
          "type": "github",
          "owner": "BurntSushi",
          "repo": "ripgrep",
          "url": "https://github.com/BurntSushi/ripgrep"
        },
        "status": "unverified",
        "binary": "rg",
        "commands": {
          "install": "mkdir -p .omni-cache/fallback && touch .omni-cache/fallback/rg",
          "check": "test -f .omni-cache/fallback/rg",
          "uninstall": "rm -f .omni-cache/fallback/rg"
        }
      }
    }
  },
  "hosts": { "testhost": [] },
  "groups": [
    { "name": "testhost", "special": "host", "tools": ["rg"] }
  ]
}
